{% include "@widget/_common/favorite.twig" %}

{% block html %}
<link rel="stylesheet" href="/themes/shop/css/drift-basic.css">
<script src="/themes/shop/js/Drift.js"></script>
    {% if widget.getParam('paginator') %}
		<div class="row column x-pages">
		    {% set paginator %}
            {{ widget.getPaginator()|raw }}
            {% endset %}
            {% do widget.application.setPageProperty( 'list-paginator', paginator ) %}
        </div>
    {% endif %}

	{% if widget.children|length %}
		{% block items %}
			{% for m in widget.children.orderBy('tag') %}
			{% if loop.first %}<div class="row medium-up-3" data-equalizer data-equalize-by-row="true">{% endif %}
    <div class="columns">
        <div class="bracelet" id="{{ m.id }}" data-equalizer-watch>
            <div class="bracelet__code">Код: {{ m.code }}</div>
				<p class="bracelet__img"><a class="view" data-toggle="drop-prod"><img src="/imagetransform/width_840_height_550_fit_2{{ m.pic }}" alt="{{ m.name }}"></a></p>
				<div class="row small-up-2">

					<div class="columns"><a class="bracelet__title" data-toggle="drop-prod">{{ m.name }}</a></div>
					<div class="columns bracelet__price">
            {% if m.bIsHidden %}
              {% if m.hasOffers %}
                {% if not m.offers.orderBy('tag','ASC')|first.bIsHidden %}
                  <a data-toggle="drop-prod">{{ m.offers.orderBy('tag','ASC')|first.displayFullPrice|raw }}</a>
                  {% else %}
                  <a href="/about/calculation/">{{m.strHiddenPrice}}</a>
                {% endif %}
              {% else %}
                <a href="/about/calculation/">{{m.strHiddenPrice}}</a>
              {% endif %}
            {% else %}
              {% if m.hasOffers and m.offers.count > 1 %}
              {{ m.offers.orderBy('tag','ASC')|first.displayFullPrice|raw }}
              {% else %}
                  {{ m.displayFullPrice|raw }}
              {% endif %}
            {% endif %}
				</div>
            </div>
        </div>
    </div>

    {% set d = 0 %}
				  {% if loop.index % 3 == 0 %}
                      {% set d = 3 %}
                  {% else %}
                      {% set d = (loop.index % 3) %}
                  {% endif %}

				  {% if loop.index % 3 == 0 or loop.index+1==loop.last or loop.last %}

    </div>
    <div class="row">
        {#% for i in loop.index-3..loop.index0 %#}
        {% for i in loop.index-d..loop.index0 %}
            <div class="columns x-product">
                <div class="filter filter_product text-left hide">
                    <div class="filter__triangle"></div>
                    <button class="close-button close-desc" aria-label="Dismiss alert" type="button" data-close=""><img
                                src="{{ basePath }}images/cross.svg" alt=""></button>
                    <div class="mb15"></div>
                    <div class="row">
                        <div class="large-16 columns large-offset-4">
                            <div class="row" data-equalizer>
                                <div class="columns medium-15 large-16 xlarge-18" data-equalizer-watch>

                                    <img class="drift-demo-trigger{{ widget.children[i].id }}" data-zoom="{{ widget.children[i].pic }}"  src="/imagetransform/width_840_height_550_fit_2{{ widget.children[i].pic }}" alt="">
                                </div>
                                <div class="columns medium-9 large-8 xlarge-6 filter__col filter__col{{ widget.children[i].id }}" data-equalizer-watch>
                                <div class="hide" id="defprice{{ widget.children[i].id }}">{{ widget.children[i].displayFullPrice|raw }}</div>
                                    <p>

                                     <a href="/about/calculation/"></a>

                                               {% if widget.children[i].bIsHidden %}
                                                 {% if widget.children[i].hasOffers %}
                                                   {% if not widget.children[i].offers.orderBy('tag','DESC')|first.bIsHidden %}
                                                     <span data-id="{{ widget.children[i].id }}">{{ widget.children[i].offers.orderBy('tag','ASC')|first.displayFullPrice|raw }}</span> <span>{% if not widget.children[i].no_engraving %}<br>цена с гравировкой{% endif %}</span>
                                                    {% else %}
                                                     <span data-id="{{ widget.children[i].id }}">{{widget.children[i].strHiddenPrice}}</span> <span>{% if not widget.children[i].no_engraving %}<br>цена с гравировкой{% endif %}</span>
                                                   {% endif %}
                                                 {% else %}
                                                <span data-id="{{ widget.children[i].id }}">{{widget.children[i].strHiddenPrice}}</span> <span>{% if not widget.children[i].no_engraving %}<br>цена с гравировкой{% endif %}</span>
                                                 {% endif %}
                                               {% else %}
                                               {% if widget.children[i].hasOffers %}
                                               <span data-id="{{ widget.children[i].id }}"><!--{{ widget.children[i].displayFullPrice|raw }}-->{{ widget.children[i].offers.orderBy('tag','ASC')|first.displayFullPrice|raw }}</span> <span>{% if not widget.children[i].no_engraving %}<br>цена с гравировкой{% endif %}</span>
                                               {% else %}
                                               {{ widget.children[i].displayFullPrice|raw }}</span> <span>{% if not widget.children[i].no_engraving %}<br>цена с гравировкой{% endif %}</span>
                                               {% endif %}
                                               {% endif %}

                                    <br>


                                    <p class="filter__art">Aрт.
                                        {{ widget.children[i].code }}<!--br>{{ widget.children[i].short|raw }}<br-->
										<br>{{ widget.children[i].name }}
                                    </p>
                                    <script>
  new Drift(document.querySelector('.drift-demo-trigger{{ widget.children[i].id }}'), {
      paneContainer: document.querySelector('.filter__col{{ widget.children[i].id }}'),
      inlinePane: 900,
      inlineOffsetY: -85,
      containInline: true,
      hoverBoundingBox: true
    });
    
  </script>
                                    <div class='filter__col-footer'>
                                    <p class='filter__col-footer-desc'>{% if not widget.children[i].isInWishList() %}<a class="filter__heart x-add-to-wishlist" data-id="{{ widget.children[i].id }}">
                                    <i class="fa fa-heart-o"></i>Добавить в избранное</a>{% else %}
                                    <a class="filter__heart x-remove-from-wishlist" data-id="{{ widget.children[i].id }}">
                                    <i class="fa fa-heart"></i>В избранном</a>{% endif %}</p>

                                    {% if (widget.children[i].bIsHidden) %}
                                      {% if widget.children[i].hasOffers %}
                                        {% if not widget.children[i].offers.orderBy('tag','DESC')|first.bIsHidden %}
                                          <a class="button inner x-add-to-cart expanded" data-id="{{ widget.children[i].id }}">В корзину</a>
                                          {% else %}
                                          <form action="/about/calculation/" method="post">
                                          <input type="hidden" name="art" value="{{ widget.children[i].code }}">
                                          <input type="hidden" name="pr_name" value="{{ widget.children[i].name }}">
                                          <button class="button inner expanded">Рассчитать цену</button></form>
                                        {% endif %}
                                      {% else %}
                                          <form action="/about/calculation/" method="post">
                                          <input type="hidden" name="art" value="{{ widget.children[i].code }}">
                                          <input type="hidden" name="pr_name" value="{{ widget.children[i].name }}">
                                          <button class="button inner expanded">Рассчитать цену</button></form>
                                      {% endif %}
                                    {% else %}
                                    <a class="button inner x-add-to-cart expanded" data-id="{{ widget.children[i].id }}">В корзину</a>
                                    {% endif %}
                                    </div>
                                </div>
                                <div class="columns">
                                	<div class="mb15"></div>
                                    {% if widget.children[i].hasOffers %}
										{% if widget.children[i].no_engraving %}
											<p class="filter__desc">Стоимость других вариантов исполнения данного изделия. Цены указаны в рублях.</p>
										{% else %}
											<p class="filter__desc">Стоимость других вариантов исполнения данного изделия. Цены указаны в рублях с учетом гравировки.</p>
										{% endif %}

                                        <div class="table-scroll">
                                            <table class="gold" id="{{ widget.children[i].id }}">
                                                <tr style="background: white;">
                                                    <td class="gold__th">Металл и камни</td>
                                                    <td class="gold__th">Цена</td>
                                                </tr>

                                                {% for of in widget.children[i].offers.orderBy('tag','ASC') %}
                                                    <tr>
                                                        <td>
                                                            <span class="g_name">{{ of.name|raw }}</span>
                                                        </td>
                                                        <td>
                                                            <div class="saphire">
                                                                {% if (of.bIsHidden == 0) %}
                                                                <input class="x-offer saphire__input" type="radio"
                                                                       name="offer{{ widget.children[i].id }}"
                                                                       value="{{ of.id }}"
                                                                       id="offer{{ of.id }}"
                                                                       {% if loop.first %}checked{% endif %}>
                                                                <label class="saphire__label g_price" for="offer{{ of.id }}">
                                                                {% endif %}
														     {% if (of.bIsHidden == 1) %}
                                 <a href="/about/calculation/">{{of.strPriceHidden}}</a>
                                 {% else %}

                                                                    {{ of.displayPrice|raw }}{% endif %}
																	{% if of.discount > 0 %}
                                                                        <del class="text-dark-gray">{{ of.displayFullPrice|raw }}</del>{% endif %}
                                                                </label>

                                                            </div>
                                                        </td>
                                                    </tr>
                                                {% endfor %}
                                            </table>
                                        </div>

                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
    <script type="text/javascript">
        document.addEventListener('DOMContentLoaded', function () {
          jQuery('.x-product').each(function(me){
            me = jQuery('.x-product')[me];
            me = $(me);
            var data = {
              action: 'is_in_cart',
              id: me.find('.x-add-to-cart').attr('data-id')
            }
            var o = me.find('.x-offer');
            if (o.length == 1) {
              data.offer_id = me.find('.x-offer').val();
            }
            else if (o.length > 1) {
              data.offer_id = me.find('.x-offer:checked').val();
            }
            //console.log(data);
            jQuery.ajax({
                url : '/plugins/sale/ajax.php',
                data: data,
                dataType: 'json',
                success: function (data) {
                  if (data.total) {
                    me.find('.x-add-to-cart').addClass('in_cart');
                    me.find('.x-add-to-cart').html('В корзине');
                  }
                }     
            }); 
        });
        $('.x-offer').on('change', function(){
            me = $(this).closest('.x-product');
            var data = {
              action: 'is_in_cart',
              id: me.find('.x-add-to-cart').attr('data-id')
            }
            data.offer_id = $(this).val();
            jQuery.ajax({
                url : '/plugins/sale/ajax.php',
                data: data,
                dataType: 'json',
                success: function (data) {
                  if (data.total) {
                    me.find('.x-add-to-cart').addClass('in_cart');
                    me.find('.x-add-to-cart').html('В корзине');
                  }
                  else {
                    me.find('.x-add-to-cart').removeClass('in_cart');
                    me.find('.x-add-to-cart').html('В корзину');
                  }
                }     
            });
        });
      });
    </script>
<div class="row medium-up-3" data-equalizer data-equalize-by-row="true">{% endif %}
    {% endfor %}
    {% endblock %}



    {% if widget.getParam('paginator') %}
        <center><div class="row column x-pages">
            {{ widget.getPaginator()|raw }}
        </div></center>
    {% endif %}

    {% endif %}
    {% endblock %}
