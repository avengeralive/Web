{% block html %}
{% if widget.param('cart_is_empty') %}

	<div class="row column">
		<div class="callout secondary">
			<p>{{ _('Ваша корзина пуста') }}</p>
		</div>
		{% if widget.param('catalog_url') %}
        <p><a href="{{ widget.param('catalog_url') }}" title="В каталог">{{ _('Вернуться в каталог') }}</a></p>
		{% endif %}
	</div>

{% elseif widget.order.id > 0 %}
{# заказ сформирован #}

    <div class="row">
      {# <div class="large-10 large-offset-3 column"> #}
      <div class="large-16 columns large-centered">
        <h5 class="individual">Завершение заказа</h5>
      </div>
    </div>
    <div class="row columns">
      <div class="cart succ">
        <div class="row">
          <div class="large-8 large-centered columns">
            <p class="cart__price">{{ _('Заказ №') }}{{ widget.order.id }} {#{{ _('от') }} {{ widget.order.date|date('d.m.Y') }}<br>{{ _('на сумму') }} {{ widget.order.getTotal(1)|raw }}#} принят!</p>
            <p>В ближайшее время наши менеджеры обязательно с Вами свяжутся.<br>При возникновении вопросов, просьба обращаться по телефону: +7 (499) 650-53-72. Время работы: с понедельника по пятницу 09:00-18:00.<br>Благодарим за Ваш заказ!</p>
          </div>
        </div>
      </div>
    </div>

