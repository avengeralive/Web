  {
    "type": "get",
    "url": "/orders/statuses",
    "title": "getBatchStatuses",
    "version": "1.0.1",
    "group": "Orders",
    "name": "getBatchStatus",
    "description": "<p>Получает статусы заказов пачкой, status и paid +комментарии<br> Расшифровка статусов: <br> status=0 - отклонено<Br> status=1 - ожидание<br> status=3 - подтвержден<br> status=5 - мусор<br> <br> Расшифрока paid: <bR> paid=4 - оплачен<Br> paid=5 - возврат(отмена)<br> paid=1 - проверка на фрод</p>",
    "parameter": {
      "fields": {
        "Parameter": [
          {
            "group": "Parameter",
            "type": "String",
            "optional": false,
            "field": "key",
            "description": "<p>Апи-Ключ для запроса</p>"
          },
          {
            "group": "Parameter",
            "type": "String",
            "optional": false,
            "field": "ids",
            "description": "<p>Ид заказов через запятую без пробелов, например: 1000,1020,2010,2004...</p>"
          }
        ]
      }
    },
    "sampleRequest": [
      {
        "url": "/v1/orders/statuses"
      }
    ],
    "success": {
      "examples": [
        {
          "title": "Ответ сервера",
          "content": "{\n  \"status\": 200,\n  \"orders\": [\n     \"id\": 1000, // ид заказа\n     \"order_status\": 1,\n     \"order_paid\": 0,\n     \"comments\": \"перезвонить\"\n  ],\n}",
          "type": "json"
        }
      ]
    },
    "filename": "/home/bdcpa/www/utilities/src/Api.php",
    "groupTitle": "Orders"
  },
