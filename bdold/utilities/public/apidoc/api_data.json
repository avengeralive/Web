  {
    "type": "post",
    "url": "/order/",
    "title": "createOrder",
    "version": "1.0.0",
    "group": "Orders",
    "name": "createOrder",
    "description": "<p>Создать новый заказ. Кодировка - UTF8<br> <B>Обратите внимание</b><br> В системе установлен фильтр, не более 1 заказа с 1 IP в течении 30 секунд.</p>",
    "parameter": {
      "fields": {
        "Parameter": [
          {
            "group": "Parameter",
            "type": "String",
            "optional": false,
            "field": "key",
            "description": "<p>Апи-Ключ для запроса</p>"
          },
          {
            "group": "Parameter",
            "type": "Number",
            "optional": false,
            "field": "stream",
            "description": "<p>ID потока</p>"
          },
          {
            "group": "Parameter",
            "type": "String",
            "optional": false,
            "field": "ip",
            "description": "<p>IP адрес клиента (формат IP v4 (xxx.xxx.xxx.xxx))</p>"
          },
          {
            "group": "Parameter",
            "type": "String",
            "optional": false,
            "field": "clientname",
            "description": "<p>ФИО клиента</p>"
          },
          {
            "group": "Parameter",
            "type": "String",
            "optional": false,
            "field": "phone",
            "description": "<p>Телефон клиента</p>"
          },
          {
            "group": "Parameter",
            "type": "Number",
            "optional": true,
            "field": "count",
            "description": "<p>Количество товаров, по дефолту 1</p>"
          },
          {
            "group": "Parameter",
            "type": "String",
            "optional": true,
            "field": "sn",
            "description": "<p>Артикул товара, размер или код</p>"
          },
          {
            "group": "Parameter",
            "type": "String",
            "optional": true,
            "field": "comments",
            "description": "<p>Комментарии к заказу</p>"
          },
          {
            "group": "Parameter",
            "type": "String",
            "optional": true,
            "field": "sub1",
            "description": "<p>subID1, по умолчанию будут выставленны те значения, которые заданы в настройках потока</p>"
          },
          {
            "group": "Parameter",
            "type": "String",
            "optional": true,
            "field": "sub2",
            "description": "<p>subID2, по умолчанию будут выставленны те значения, которые заданы в настройках потока</p>"
          },
          {
            "group": "Parameter",
            "type": "String",
            "optional": true,
            "field": "sub3",
            "description": "<p>subID3, по умолчанию будут выставленны те значения, которые заданы в настройках потока</p>"
          },
          {
            "group": "Parameter",
            "type": "String",
            "optional": true,
            "field": "email",
            "description": "<p>Почта пользователя</p>"
          },
          {
            "group": "Parameter",
            "type": "String",
            "optional": true,
            "field": "referer",
            "description": "<p>Referer пользователя (откуда пришел)</p>"
          },
          {
            "group": "Parameter",
            "type": "String",
            "optional": true,
            "field": "externalWebmaster",
            "description": "<p>externalWebmaster (откуда пришел)</p>"
          }
        ]
      }
    },
    "sampleRequest": [
      {
        "url": "/v1/order/"
      }
    ],
    "success": {
      "examples": [
        {
          "title": "Пример ответа",
          "content": "{\n     status: 200,\n     id: 3293\n}",
          "type": "json"
        }
      ]
    },
