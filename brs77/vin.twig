{{ header }}
<div class="container">
  <ul class="breadcrumb">
    <li><a href="/"><i class="fa fa-home"></i></a></li>
    <li>Записаться на кузовной ремонт</li>
  </ul>
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <style>.form-group { margin: 0px !important; }</style>
    <div id="content" class="{{ class }}">{{ content_top }}
      <h1>Подбор запчастей по VIN номеру</h1>
      <form action="index.php?route=information/form2" method="post" enctype="multipart/form-data" class="form-horizontal col-xs-12 col-sm-6">
        <div class="row">
          <div class="col-xs-12 form-group">
            <label for="name">Ваше имя</label>
            <input type="text" name="name" class="form-control">
          </div>
          <div class="col-xs-12 form-group">
            <label for="phone">Ваш телефон</label>
            <input type="text" name="phone" class="form-control">
          </div>
        </div>
        <div class="row">
          <div class="col-xs-12 form-group">
            <label for="email">Ваш email для обратной связи</label>
            <input type="email" name="email" class="form-control">
          </div>
          <div class="col-xs-12 form-group">
            <label for="car_model">Марка и модель автомобиля</label>
            <input type="text" name="car_model" class="form-control">
          </div>
        </div>
        <div class="row">
          <div class="col-xs-12 form-group">
            <label for="vin">VIN номер</label>
            <input type="text" name="vin" class="form-control">
          </div>
          <div class="col-xs-12 form-group">
            <label for="zap">Список запчастей</label>
            <textarea name="zap" rows="5" class="form-control"></textarea>
          </div>
        </div>
        <div class="row">
          <div class="col-xs-12">
            <p><label for="orig">
              <input type="radio" name="orig" value="1"> Оригинал
            </label></p>
            <p><label for="orig">
              <input type="radio" name="orig" value="0"> Не оригинал
            </label></p>
            <p><label for="bu">
              <input type="checkbox" name="bu" value="1"> Б/у
            </label></p>
          </div>
        </div>
        <div class="row">
          <div class="col-xs-12 form-group">
            <button type="submit" class="btn btn-success">Отправить</button>
          </div>
        </div>
        
        
      </form>
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
{{ footer }}
