u003c\/p\u003e\n  \u003c\/div\u003e\n  \n\n  \n  \u003cdiv class=\"product-techoverview--item\"\u003e\n    \u003ch4\u003eCase\u003c\/h4\u003e\n    \u003cp\u003eStainless steel Bremont Trip-Tick® case construction with scratch resistant DLC treated case barrel. Case diameter 40mm. Overall height 13mm. Lug width 20mm. Polished ceramic uni-directional rotating bezel with Super-LumiNova®\u003c\/p\u003e\n  \u003c\/div\u003e\n  \n\n  \n  \u003cdiv class=\"product-techoverview--item\"\u003e\n    \u003ch4\u003eCase Back\u003c\/h4\u003e\n    \u003cp\u003eStainless steel screw-in and decorated case back.\u003c\/p\u003e\n  \u003c\/div\u003e\n  \n\n  \n  \u003cdiv class=\"product-techoverview--item\"\u003e\n    \u003ch4\u003eDial and Hands\u003c\/h4\u003e\n    \u003cp\u003ePainted white dial with Super-LumiNova® coated numerals and indexes. Nickel satin hands filled with Super-LumiNova®\u003c\/p\u003e\n  \u003c\/div\u003e\n  \n\n  \n  \u003cdiv class=\"product-techoverview--item\"\u003e\n    \u003ch4\u003eCrystal\u003c\/h4\u003e\n    \u003cp\u003eDomed anti-reflective, scratch resistant sapphire crystal.\u003c\/p\u003e\n  \u003c\/div\u003e\n  \n\n  \n  \u003cdiv class=\"product-techoverview--item\"\u003e\n    \u003ch4\u003eWater Resistance\u003c\/h4\u003e\n    \u003cp\u003eWater resistant to 30 ATM, 300 metres.\u003c\/p\u003e\n  \u003c\/div\u003e\n  \n\n  \n  \u003cdiv class=\"product-techoverview--item\"\u003e\n    \u003ch4\u003eStrap\u003c\/h4\u003e\n    \u003cp\u003e20mm Stainless Steel bracelet.\u003c\/p\u003e\n  \u003c\/div\u003e\n  \n\n  \n  \u003cdiv class=\"product-techoverview--item\"\u003e\n    \u003ch4\u003eRatings and Certification\u003c\/h4\u003e\n    \u003cp\u003eChronometer rated to ISO 3159 standard.\u003c\/p\u003e\n  \u003c\/div\u003e\n  \n\n  \n  \u003c\/div\u003e\n\t\n  \u003ca class=\"open__tech\"\u003e\u003c\/a\u003e\n\u003c!--   \u003ca class=\"close__tech\"\u003e\u003cspan\u003eCLOSE\u003c\/span\u003e\u003c\/a\u003e --\u003e\n\u003c\/div\u003e\n\n"
