 rubber strap\u003c\/li\u003e\n\u003c\/ul\u003e\u003c\/p\u003e\n      \u003c\/div\u003e\n    \u003c\/div\u003e\n    \n    \n    \u003cdiv class=\"product-main-end\"\u003e  \n      \u003cdiv class=\"product-find\"\u003e\n        \u003ca href=\"\/pages\/store-locator\"\u003eFind a store\u003c\/a\u003e\n      \u003c\/div\u003e \n      \n      \n            \u003caside class=\"share-buttons\"\u003e  \u003cdiv class=\"share-buttons--list\"\u003e    \u003ca      class=\"share-buttons--button share-buttons--facebook\"      target=\"_blank\"      href=\"\/\/www.facebook.com\/sharer.php?u=https:\/\/www.bremont.com\/products\/s2000-yellow\"\u003e      \u003csvg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" viewBox=\"0 0 19.485 19.564\"\u003e        \u003cpath id=\"FB\" fill=\"#071f2d\" d=\"M17.056,0H2.425A2.426,2.426,0,0,0,0,2.425V17.056a2.426,2.426,0,0,0,2.425,2.425H9.866V12.541H7.525V9.448H9.866v-1.5a4.038,4.038,0,0,1,3.93-4.18h2.174V7.19H14.046a.613.613,0,0,0-.669.669V9.448h2.592v3.093H13.377v7.023h3.679a2.426,2.426,0,0,0,2.425-2.425V2.425A2.326,2.326,0,0,0,17.056,0Z\" transform=\"translate(0 0)\"\/\u003e      \u003c\/svg\u003e      \u003cspan class=\"show-for-sr\"\u003eShare on Facebook\u003c\/span\u003e    \u003c\/a\u003e    \u003ca      class=\"share-buttons--button share-buttons--twitter\"      target=\"_blank\"      href=\"\/\/twitter.com\/share?url=https:\/\/www.bremont.com\/products\/s2000-yellow\"\u003e      \u003csvg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" viewBox=\"0 0 19.486 15.76\"\u003e        \u003cpath id=\"Twitt\" fill=\"#071f2d\" d=\"M19.386,1.863a7.462,7.462,0,0,1-2.251.621A3.82,3.82,0,0,0,18.92.311a7.246,7.246,0,0,1-2.562.932A3.929,3.929,0,0,0,13.486,0,3.976,3.976,0,0,0,9.527,3.959a3.78,3.78,0,0,0,.078.932A11.567,11.567,0,0,1,1.3.7,4.611,4.611,0,0,0,.754,2.717,4.144,4.144,0,0,0,2.54,6.055,3.692,3.692,0,0,1,.754,5.512V5.59A3.931,3.931,0,0,0,3.937,9.471a4.582,4.582,0,0,1-1.087.155,2.641,2.641,0,0,1-.776-.078A4.117,4.117,0,0,0,5.8,12.344,8.023,8.023,0,0,1,.832,