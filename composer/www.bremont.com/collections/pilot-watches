_window();return false;\" class=\"livechat__link\"\u003eChat now\u003c\/a\u003e\u003c\/p\u003e\n\n\u003c!--       \u003ca class=\"btn open__enquiry_form\"\u003eMake an enquiry\u003c\/a\u003e --\u003e\n      \n    \u003c\/div\u003e\n    \n    \u003cdiv class=\"product-bracelet-description\"\u003e\n      \n    \u003c\/div\u003e\n    \n    \n    \n    \n    \u003cdiv class=\"product-description\"\u003e\n      \u003ca class=\"dropdown\"\u003eDESCRIPTION\u003c\/a\u003e\n      \u003cdiv class=\"product-description--content\"\u003e\n        \u003cp\u003e\u003cp\u003e\u003cstrong\u003eThis model is currently in production \u0026amp; all online deliveries will be made approximately 2 weeks from purchase date.\u003c\/strong\u003e\u003c\/p\u003e\n\u003cbr\u003e\n\u003cp\u003eBremont is extremely proud to be the first watch brand to sign the United Kingdom’s Armed Forces Covenant in February 2019. As part of our commitment to supporting those serving in the armed forces, we are \u003cstrong\u003eoffering a subsidy of 15% on this model for all eligible military serving members and veterans\u003c\/strong\u003e. To place an order using this subsidy, simply contact our concierge service on +44 (0) 1491 876 285. Please note a valid military ID or Defence Discount Service card will be required for verification. \u003cspan\u003eThis subsidy cannot be used when purchasing via Divido finance.\u003c\/span\u003e\u003c\/p\u003e\n\u003cbr\u003e\n\u003cp\u003eThe Bremont Arrow is a 42mm cased mono-pusher chronograph. The pusher at 2 o’clock on the two-piece hardened steel case will start, stop and reset the stopwatch on the chronometer rated BE-51AE movement. The Arrow plays on the same British military DNA as the Broadsword but is aimed at the airman with its chronograph functionality, a necessity for any timed mission. The sub-dial at 9 o’clock is a running seconds, and the chronograph has elapsed minutes on the 3 o’clock counter. Engineered with the utmost integrity, the Arrow is steadfastly accurate, durable and legible.\u003c\/p\u003e\n\u003cul\u003e\n\u003cli\u003eBE-51AE automatic chronometer with 48-hour power reserve\u003c\/li\u003e\n\u003cli\u003e42mm satin and polished two-piece case construction\u003c\/li\u003e\n\u003cli\u003eWater resistant to 10ATM, 100 metres\u003c\/li\u003e\n\u003cli\u003e20mm RAF blue sailcloth strap\u003c\/li\u003e\n\u003c\/ul\u003e\u003c\/p\u003e\n      \u003c\/div\u003e\n    \u003c\/div\u003e\n    \n    \n    \u003cdiv class=\"product-main-end\"\u003e  \n      \u003cdiv class=\"product-find\"\u003e\n        \u003ca href=\"\/pages\/store-locator\"\u003eFind a store\u003c\/a\u003e\n      \u003c\/div\u003e \n      \n      \n            \u003caside class=\"share-buttons\"\u003e  \u003cdiv class=\"share-buttons--list\"\u003e    \u003ca      class=\"share-buttons--button share-buttons--facebook\"      target=\"_blank\"      href=\"\/\/www.facebook.com\/sharer.php?u=https:\/\/www.bremont.com\/products\/arrow\"\u003e      \u003csvg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" viewBox=\"0 0 19.485 19.564\"\u003e        \u003cpath id=\"FB\" fill=\"#071f2d\" d=\"M17.056,0H2.425A2.426,2.426,0,0,0,0,2.425V17.056a2.426,2.426,0,0,0,2.425,2.425H9.866V12.541H7.525V9.448H9.866v-1.5a4.038,4.038,0,0,1,3.93-4.18h2.174V7.19H14.046a.613.613,0,0,0-.669.669V9.448h2.592v3.093H13.377v7.023h3.679a2.426,2.426,0,0,0,2.425-2.425V2.425A2.326,2.326,0,0,0,17.056,0Z\" transform=\"translate(0 0)\"\/\u003e      \u003c\/svg\u003e      \u003cspan class=\"show-for-sr\"\u003eShare on Facebook\u003c\/span\u003e    \u003c\/a\u003e    \u003ca      class=\"share-buttons--button share-buttons--twitter\"      target=\"_blank\"      href=\"\/\/twitter.com\/share?url=https:\/\/www.bremont.com\/products\/arrow\"\u003e      \u003csvg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" viewBox=\"0 0 19.486 15.76\"\u003e        \u003cpath id=\"Twitt\" fill=\"#071f2d\" d=\"M19.386,1.863a7.462,7.462,0,0,1-2.251.621A3.82,3.82,0,0,0,18.92.311a7.246,7.246,0,0,1-2.562.932A3.929,3.929,0,0,