, scratch resistant sapphire crystal.\u003c\/p\u003e\n  \u003c\/div\u003e\n  \n\n  \n  \u003cdiv class=\"product-techoverview--item\"\u003e\n    \u003ch4\u003eWater Resistance\u003c\/h4\u003e\n    \u003cp\u003eWater resistant to 10 ATM, 100 metres.\u003c\/p\u003e\n  \u003c\/div\u003e\n  \n\n  \n  \u003cdiv class=\"product-techoverview--item\"\u003e\n    \u003ch4\u003eStrap\u003c\/h4\u003e\n    \u003cp\u003e20mm Khaki green sailcloth strap.\u003c\/p\u003e\n  \u003c\/div\u003e\n  \n\n  \n  \u003cdiv class=\"product-techoverview--item\"\u003e\n    \u003ch4\u003eRatings and Certification\u003c\/h4\u003e\n    \u003cp\u003eChronometer rated to ISO 3159 standard.\u003c\/p\u003e\n  \u003c\/div\u003e\n  \n\n  \n  \u003c\/div\u003e\n\t\n  \u003ca class=\"open__tech\"\u003e\u003c\/a\u003e\n\u003c!--   \u003ca class=\"close__tech\"\u003e\u003cspan\u003eCLOSE\u003c\/span\u003e\u003c\/a\u003e --\u003e\n\u003c\/div\u003e\n\n"
