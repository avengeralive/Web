
body {
    min-width: 320px;
    background: #fff;
    font-family: 'AvenirNextCyr', sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 1.5em;
    color: #333;
    cursor: default;
}

header, section, footer {
    margin: 0 auto;
    max-width: 1920px;
}

.wrapper {
    margin: 0 auto;
    padding: 0 10px;
    width: 960px;
    position: relative;
}
section>.wrapper{
    padding: 30px 0 40px;
}
.section_title{
    font-size: 36px;
    line-height: 1.3em;
    font-weight: 700;
    text-transform: uppercase;
    text-align: center;
    margin-bottom: 30px;
}
.section_title>span{
    color: #6b8fe5;
}
.clearfix:after {
    content: "";
    display: block;
    clear: both;
}

img {
    max-width: 100%;
    height: auto;
}

b {
    font-weight: 700;
}

/* style */
.title_block{
    height: 70px;
    background: rgb(187,196,244);
    background: -moz-linear-gradient(left, rgba(187,196,244,1) 0%, rgba(205,216,246,1) 17%, rgba(208,219,247,1) 82%, rgba(210,220,247,1) 100%);
    background: -webkit-linear-gradient(left, rgba(187,196,244,1) 0%,rgba(205,216,246,1) 17%,rgba(208,219,247,1) 82%,rgba(210,220,247,1) 100%);
    background: linear-gradient(to right, rgba(187,196,244,1) 0%,rgba(205,216,246,1) 17%,rgba(208,219,247,1) 82%,rgba(210,220,247,1) 100%);
    filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#bbc4f4', endColorstr='#d2dcf7',GradientType=1 );
}
.title_block .wrapper{
    padding: 0px 10px;
}
.title_block .logo{
    display: inline-block;
    width: 220px;
    background: #fff;
}
.title_block .logo>img{
    display: block;
    margin: 0px auto;
}
.title_block ul{
    float: right;
    padding: 14px 0 0;
}
.title_block ul>li{
    float: left;
    width: 210px;
    margin: 0 0 0 15px;
    font-size: 15px;
    line-height: 1.4em;
}
.title_block ul>li:before{
    content: '';
    display: block;
    float: left;
    width: 42px;
    height: 42px;
    margin: 0 10px 0 0;
    background: url(../img/head-icon.png) no-repeat;
}
.title_block ul>li:nth-child(1):before{
    background-position: 0 0;
}
.title_block ul>li:nth-child(2):before{
    background-position: -42px 0;
}
.title_block ul>li:nth-child(3):before{
    background-position: -84px 0;
}

/*top_offer*/
.top_offer{
    background: #fff url(../img/top_offer_bg.jpg) 50% 100% no-repeat;
}
.top_offer .wrapper{
    padding: 15px 10px 20px 330px;
    position: relative;
}
.top_offer .main_subtitle{
    font-size: 30px;
    font-weight: 700;
    line-height: 1.4em;
}
.top_offer .main_title{
    font-size: 42px;
    color: #6b8fe5;
    text-transform: uppercase;
    line-height: 1.1em;
    margin-bottom: 10px;
}
.top_offer h3{
    font-size: 20px;
    font-weight: 700;
    line-height: 1.3em;
}
.top_offer .sale{
    width: 116px;
    height: 116px;
    background: url(../img/sale_bg.png) 50% 50% no-repeat;
    text-align: center;
    padding-top: 20px;
    position: absolute;
    top: 210px;
    left: 360px;
    color: #fff;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 1px;
}
.sale>span{
    display: block;
    font-weight: 700;
    font-size: 30px;
    line-height: 1.005em;
    letter-spacing: normal;
    margin: 0 0 -5px;
}
.action_block{
    padding: 20px 0 0 300px;
}
.action_block .bullets{
    padding: 0 20px 0 0;
}
.action_block .bullets>li{
    font-size: 17px;
    padding: 0 0 0 32px;
    background: url(../img/of_bullets_icon.png) 0% 4px no-repeat;
    margin-bottom: 15px;
}
.price{
    margin-bottom: 15px;
}
.price .price_item{
    font-size: 12px;
    text-transform: uppercase;
    width: 50%;
    float: left;
}
.price_item>span{
    display: block;
    font-size: 36px;
    font-weight: 700;
    line-height: 1.1em;
}
.price_item.old{
    text-align: right;
    padding: 0 15px 0 0;
}
.price_item.new{
    text-align: left;
    padding: 0 0 0 15px;
}
.price_item.old>span{
    text-decoration: line-through;
}
.price_item.new>span{
    color: #6b8fe5;
}
.price_item>span>small{
    font-size: 0.8em;
}
.button_m{
    text-decoration: none;
    border: none;
    color: #fff;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    background: #6b8fe5;
    width: 300px;
    height: 68px;
    font-size: 18px;
    line-height: 68px;
    border-radius: 30px;
    display: block;
    text-align: center;
    font-family: 'AvenirNextCyr', sans-serif;
    cursor: pointer;
}
.button_m:hover{
    background: #5180f2;
}
.button_m:focus{
    background: #5180f2;
}
.product_count{
    text-align: center;
    margin-top: 15px;
}
.product_count:before{
    content: '';
    width: 20px;
    height: 20px;
    background: url(../img/prd_count_icon.png) 50% 50% no-repeat;
    display: inline-block;
    margin: -3px 10px 0 0;
    vertical-align: middle;
}
.s3 h3 {
    font-size: 24px;
    text-align: center;
    text-transform: uppercase;
    margin: 60px 0 30px;
    color:#6b8fe5;
}
.ingredients {
    font-size: 0;
    text-align: center;
}
.ingredients li {
    display: inline-block;
    vertical-align: top;
    width: 20%;
    padding: 0 10px;
}
.ingredients li img {
    border-radius: 50%;
    width: 130px;
}

.ingredients b {
    font-weight: 700;
    font-size: 16px;
    text-transform: uppercase;
    display: block;
}
.ingredients p {
    font-size: 16px;
}

.change_block .change_cont{
    border: 1px solid #f7faff;
    border-radius: 4px;
}
.change_block .change_cont>li{
    float: left;
    width: 25%;
    padding: 20px 15px;
    text-align: center;
}
.change_block .change_cont>li:nth-child(2n){
    background: #f7faff;
}
.change_block .change_cont>li img{
    display: block;
    margin: 0 auto 20px;
}
.thumb {
    height: 131% !important;
}
.change_block .change_cont>li>h4{
    padding: 0 0 10px;
    font-weight: 700;
}

/* s3 */
.s3{
    background: url(../img/bg2.jpg);
    background-size: cover;
}
.s3_video{
    float: left;
    width: 460px;
    height: 300px;
    border-radius: 14px;
    overflow: hidden;
    background: #000;
}
.s3_video iframe{
    width: 100%;
    height: 100%;
}
.s3_text{
    padding: 0 0 0 480px;
}
.s3_text>p{
    margin-bottom: 15px;
    line-height: 1.6em;
}
.colul {
    text-align: center;
    font-size
}
.colul img {
    margin-bottom: 10px;
}
.colul h3 {
    font-weight: 700;
    font-size: 1.5em;
}
.colul b {
    display: block;
    color: #6b8fe5;
}
.result_cont>li{
    float: left;
    width: 220px;
    margin: 0 10px;
    text-align: center;
    background: #f7faff;
    border-radius: 4px;
    overflow: hidden;
}
.result_cont>li>img{
    display: block;
    margin: 0 auto;
}
.result_cont>li p{
    padding: 20px 5px;
    font-weight: 500;
}

.s5{
    background: #6b8fe5 url(../img/s5_bg.jpg) 50% 0% no-repeat;
}
.s5 .section_title{
    font-size: 30px;
    line-height: 1.3em;
    text-align: left;
}
.s5_top{
    padding: 50px 450px 0 0;
}
.s5_top>p{
    margin: 20px 0;
    font-size: 18px;
    line-height: 1.6em;
}
.s5_bottom{
    padding: 80px 0 10px 0;
}
.s5_bottom>h3{
    color: #fff;
    font-weight: 700;
    font-size: 30px;
    line-height: 1.3em;
    text-align: center;
    margin-bottom: 30px;
    position: relative;
}
.s5_bottom>h3:after{
    content: '';
    height: 29px;
    width: 25px;
    background: url(../img/arrow_to_form.png) 50% 50% no-repeat;
    position: absolute;
    right: 5px;
    bottom: -15px;
}
.s5 .m1-form input,
.s5 .m1-form .button_m,
.bottom_offer .m1-form input{
    width: 300px;
    border: none;
    height: 60px;
    border-radius: 30px;
    float: left;
    font-family: 'AvenirNextCyr', sans-serif;
    text-align: center;
    font-size: 18px;
}
.s5 .m1-form .button_m{
    line-height: 60px;
}
.s5 .m1-form input:nth-child(2){
    margin: 0px 30px;
}

/* s6 */
.s6 {
    background-image: url(../img/bg3.jpg);
    background-size: cover;
}
.s6 .change_cont>li>img{
    width: 145px;
}

/* s7 */
.s7{
    background: url(../img/bg4.jpg);
    background-size: cover;
}
.result_img>img{
    display: block;
    float: left;
    margin-bottom: 20px;
    border-radius: 10px;
}
.result_img>img:nth-child(2n){
    margin-left: 20px;
}

/* s8 */
.s8 .wrapper{
    position: relative;
}
.s8 .s8_img{
    position: absolute;
    left: 0px;
    bottom: 0px;
}
.s8 .section_title{
    text-align: left;
}
.s8_list > li{
    position: relative;
    padding: 0 0 0 50px;
    line-height: 1.5em;
    margin-bottom: 20px;
}
.s8_list > li > span{
    width: 36px;
    height: 36px;
    display: block;
    border-radius: 50%;
    background: #6b8fe5;
    color: #fff;
    font-weight: 700;
    text-align: center;
    line-height: 36px;
    position: absolute;
    left: 0px;
    top: 3px;
    font-size: 18px;
}
.s8 .button_m{
    margin: 30px auto 0;
}

/* s9 */
.blue_theme{
    background: #518ded url(../img/s9_bg.jpg);
    background-size: cover;
}
.blue_theme .section_title{
}
.rev_item{
    width: 300px;
    background: #fff;
    border-radius: 20px;
    overflow: hidden;
    padding: 0 0 15px;
    height: 575px;
}
.rev_item>img{
    display: block;
    margin-bottom: 10px;
}
.char {
    background-color: #333;
    color: #fff !important;
    padding: 15px;
    border-radius: 10px;
    transform: scale(0.95);
    display: block;
    margin-bottom: 20px;
}
.rev_item h4{
    font-weight: 700;
    margin-bottom: 10px;
    text-align: center;
    padding: 0 10px;
    font-size: 1.2em;
}
.rev_item h4:after{
    content: '”';
    color: #6b8fe5;
    font-size: 60px;
    display: block;
    text-align: center;
    font-family: 'Times New Roman';
    margin: 0px 0 -35px 0;
}
.rev_item p{
    margin-top: 15px;
    text-align: center;
    padding: 0 10px;
}

/*s9*/
