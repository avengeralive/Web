<link rel="stylesheet" href="files/c/cpa-sale/dvr-j.ru/files/widget/style.css" type="text/css">

<style type="text/css">
#rc-connect > div {
    bottom: 30px !important;
    left: auto !important;
    top: auto !important;
    right: 30px !important;
}
@media (max-width: 1100px) {
    #rc-connect {
        display: none !important;
    }
    #rc-connect > div {
        display: none !important;
    }
}
#rc-phone-input {font-style: normal;}
</style>
 

<script src="files/c/cpa-sale/dvr-j.ru/files/widget/main.js" type="text/javascript"></script>

<script type="text/javascript">
var $ = jQuery;
var timer;
var timer2;
window.onload = function(){
  if($(document).width()>980){
    $('#rc-connect').show();
  }
}

$(document).ready(function($){
  $('#rc-phone-input').inputmask('+7 (999) 999-99-99', {placeholder: ' '});
});

$('#rc-phone-input').focus();

$('#rc-phone-back, #rc-phone-highlight').click(function(){
  $('#rc-phone-form-wrap-curtain').css('overflow', 'visible');
  $('#rc-phone').removeClass('rc-inactive').addClass('rc-expanded');
});

$('#rc-feedback-vote-no').click(function(){
  $('#rc-feedback-vote').hide();
  $('#rc-feedback-comment').show();
  $('#rc-phone').removeClass('rc-inactive').addClass('rc-expanded');
});

$('#rc-feedback-vote-yes').click(function(){
  $('#rc-overlay').hide();
  $('#rc-feedback').hide();
  $('#rc-feedback-vote').hide();
  $('#rc-feedback-comment').hide();
  $('#rc-phone').removeClass('rc-expanded rc-dial-progress rc-timeout rc-dial-shown rc-dial-shown-long').addClass('rc-inactive');
  $('#rc-phone').show();
});

$('#rc-feedback-close').click(function(){
  $('#rc-overlay').hide();
  $('#rc-feedback').hide();
  $('#rc-feedback-vote').hide();
  $('#rc-feedback-comment').hide();
  $('#rc-phone').removeClass('rc-expanded rc-dial-progress rc-timeout rc-dial-shown rc-dial-shown-long').addClass('rc-inactive');
  $('#rc-phone').show();
});

$('#rc-phone-form-close').click(function(){
  $('#rc-phone-form-wrap-curtain').css('overflow', 'hidden');
  $('#rc-phone').removeClass('rc-expanded rc-dial-progress rc-timeout rc-dial-shown rc-dial-shown-long').addClass('rc-inactive');
});

$('#rc-phone-dial-close').click(function(){
  $('#rc-phone').removeClass('rc-expanded rc-dial-progress rc-timeout rc-dial-shown rc-dial-shown-long').addClass('rc-inactive');
  clearTimeout(timer);
  clearTimeout(timer2);
});

$('#rc-feedback-comment-button').click(function(){
  $('#rc-overlay').hide();
  $('#rc-feedback').hide();
  $('#rc-phone').removeClass('rc-expanded rc-dial-progress rc-timeout rc-dial-shown rc-dial-shown-long').addClass('rc-inactive');
  $('#rc-phone').show();
});

$('#rc-phone-button').click(function(){
  var re = /^\+7\s\(9\d\d\)\s\d\d\d-\d\d-\d\d$/;
  var myPhone = $('#rc-phone-input').val();
  var valid = re.test(myPhone);
  
  if(valid){
    $('#rc-phone-form-wrap-curtain').css('overflow', 'hidden');
    $('#rc-phone-input-warning').removeClass('rc-active');
  }else{
    $('#rc-phone-input-warning').addClass('rc-active');
    return false;
  }
  
  $('#rc-phone').removeClass('rc-expanded').addClass('rc-dial-progress rc-timeout rc-dial-shown rc-dial-shown-long');
  $('#rc-phone-dial').show();
  $('#rc-phone-dial-timer').show();
  $('#rc-phone-dial-descr').show();
  $('#rc-phone-dial-descr').css('top', '6.7em');
  
 
 

  function onAjaxSuccess(data){
    try{yaCounter50191489.reachGoal('widget');}catch(e){console.error(e);}
    
    $('#rc-phone-dial-descr2').html('Соединяем с оператором...');
    
    var countdown = new Date(), responseTime = new Date(Date.now() + (2800 * 10));

    function startTime() {
      countdown.setTime(responseTime - Date.now());

      if (countdown.getUTCSeconds() < 10) {
        $('#rc-phone-dial-timer2').html('00:0' + countdown.getUTCSeconds() + ':' + Math.round(countdown.getUTCMilliseconds() / 10));
      } else {
        $('#rc-phone-dial-timer2').html('00:' + countdown.getUTCSeconds() + ':' + Math.round(countdown.getUTCMilliseconds() / 10));
      }

      //timeElem.innerHTML = countdown.getUTCSeconds() + ':' + countdown.getUTCMilliseconds();
      if (countdown.getUTCMinutes() > 0 || countdown.getUTCSeconds() > 0)
        requestAnimationFrame(startTime);
      else {
        if (countdown.getUTCSeconds() <= 0) {
          clearTimeout(timer);
          $('#rc-phone-dial-timer').hide();
          $('#rc-phone-dial-descr').css('top', '5em');
          timer2 = setTimeout(function() {
            $('#rc-phone-dial').hide();
            $('#rc-phone-dial-timer').hide();
            $('#rc-phone-dial-descr').hide();
            $('#rc-phone').hide();
            $('#rc-feedback-comment').hide();
            $('#rc-overlay').show();
            $('#rc-feedback').show();
            $('#rc-feedback-vote').show();
          }, 5000);
        }
      }
    }
    
    requestAnimationFrame(startTime);
    return false;
  }
  return false;
});
</script>


 



