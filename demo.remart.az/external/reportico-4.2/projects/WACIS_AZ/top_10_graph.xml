  FROM `f_operations` fo,  `f_accounts` fa , `h_contractors` hc 
  WHERE fo.debet  =fa.account_num 
       AND hc.reg_num =  fa.reg_num
       AND fa.type = 'P'
      AND hc.contractor_category_id !=3
	   AND fo.status = 'AC'  
	   [ AND  fo.reg_date between {DateInterval,RANGE1} and {DateInterval,RANGE2} ] 
