<?xml version="1.0"?><Report><ReportQuery><Format><ReportTitle>Anbarın məbləğ qalığı</ReportTitle><ReportDescription></ReportDescription><PageSize>.DEFAULT</PageSize><PageOrientation>.DEFAULT</PageOrientation><TopMargin></TopMargin><BottomMargin></BottomMargin><RightMargin></RightMargin><LeftMargin></LeftMargin><pdfFont></pdfFont><pdfFontSize></pdfFontSize><PreExecuteCode>NONE</PreExecuteCode><formBetweenRows>solidline</formBetweenRows><gridDisplay>.DEFAULT</gridDisplay><gridSortable>.DEFAULT</gridSortable><gridSearchable>.DEFAULT</gridSearchable><gridPageable>.DEFAULT</gridPageable><gridPageSize>.DEFAULT</gridPageSize></Format><Datasource><SourceType>database</SourceType><SourceConnection><DatabaseType>mysql</DatabaseType><DatabaseName></DatabaseName><HostName></HostName><ServiceName></ServiceName><UserName></UserName><Password></Password></SourceConnection></Datasource><EntryForm><Query><TableSql></TableSql><WhereSql></WhereSql><GroupSql></GroupSql><RowSelection>all</RowSelection><SQL><QuerySql></QuerySql><SQLRaw>SELECT l.id,
       l.name,
       l.item_name,
       l.f_count,
       l.l_prixod,
       l.k_rasxod,
       l.k_ostatok,
       getTotalAmount(l.id,k_ostatok) summ_amount,
       getTotalAmount(l.id,(limit_cnt-k_ostatok)) project_amount_summ,
       l.limit_cnt,
       (limit_cnt-k_ostatok) layihe_qaliq
FROM
  (SELECT m.id,
          hs.name,
          item_name,
          SUM(m.f_count) AS f_count,
          SUM(m.count) AS l_prixod,
          SUM(m.minus_count) AS k_rasxod,
          SUM(m.count)+SUM(m.minus_count)+SUM(m.f_count) AS k_ostatok,
           limit_cnt
   FROM
	  (SELECT  t1.id ,   
				t2.storage_id,   
				t1.item_name, 
				0 as f_count, 
				t3.count count, 
				0 as minus_count ,
				(SELECT max(limit_cnt) FROM `h_items_info`  WHERE item_id = t1.id) as limit_cnt, 
				t2.count info_count 
		  FROM `h_items` t1, `h_items_info` t2 , `nf_operations` t3 
		  WHERE t1.id = 1041  
			AND t2.item_id = t1.id  
			AND t3.item_id = t2.id
			AND t3.count &gt; 0 
			AND t3.operation_type_id NOT IN (1,2,6)
			AND t3.status = 'AC'
		  [ AND DATE(t3.change_date) between {periodDate,RANGE1} and {periodDate,RANGE2} ]
      UNION ALL 
		SELECT  t1.id ,   
				t2.storage_id,   
				t1.item_name, 
				0 as f_count, 
				0 as count, 
				t3.count as minus_count ,
				(SELECT max(limit_cnt) FROM `h_items_info`  WHERE item_id = t1.id) as limit_cnt, 
				t2.count info_count 
		  FROM `h_items` t1, `h_items_info` t2 , `nf_operations` t3 
		  WHERE t1.id = 1041  
			AND t2.item_id = t1.id  
			AND t3.item_id = t2.id
			AND t3.count &lt; 0 
			AND t3.operation_type_id NOT IN (1,2,6)
			AND t3.status = 'AC'
		  [ AND DATE(t3.change_date) between {periodDate,RANGE1} and {periodDate,RANGE2} ]
      UNION ALL
	   SELECT  t1.id ,   
				t2.storage_id,   
				t1.item_name, 
				t3.count as f_count, 
				0 as count, 
				 0 as minus_count ,
				(SELECT max(limit_cnt) FROM `h_items_info`  WHERE item_id = t1.id) as limit_cnt, 
				t2.count info_count 
		  FROM `h_items` t1, `h_items_info` t2 , `nf_operations` t3 
		  WHERE t1.id = 1041  
			AND t2.item_id = t1.id  
			AND t3.item_id = t2.id
			AND t3.count &lt; 0 
			AND t3.operation_type_id NOT IN (1,2,6)
			AND t3.status = 'AC'
		  [ AND DATE(t3.change_date)&lt; {periodDate,RANGE1} ]) m,
        h_storages hs
   WHERE m.storage_id = hs.id [ AND m.id  in  ({item_id}) ] [ AND m.storage_id  in  ({storage_id}) ]
   GROUP BY m.id,
            hs.name) l</SQLRaw></SQL><QueryColumns><QueryColumn><Name>id</Name><TableName>l</TableName><ColumnName>id</ColumnName><ColumnType>char</ColumnType><ColumnLength>30</ColumnLength><Format><column_display>show</column_display><content_type>plain</content_type><ColumnStartPDF></ColumnStartPDF><justify>left</justify><ColumnWidthPDF></ColumnWidthPDF><ColumnWidthHTML></ColumnWidthHTML><column_title>Malın kodu</column_title><tooltip></tooltip><group_header_label>0</group_header_label><group_header_label_xpos></group_header_label_xpos><group_header_data_xpos></group_header_data_xpos><group_trailer_label>0</group_trailer_label></Format></QueryColumn><QueryColumn><Name>name</Name><TableName>l</TableName><ColumnName>name</ColumnName><ColumnType>char</ColumnType><ColumnLength>30</ColumnLength><Format><column_display>show</column_display><content_type>plain</content_type><ColumnStartPDF></ColumnStartPDF><justify>left</justify><ColumnWidthPDF></ColumnWidthPDF><ColumnWidthHTML></ColumnWidthHTML><column_title>Anbar</column_title><tooltip></tooltip><group_header_label>0</group_header_label><group_header_label_xpos></group_header_label_xpos><group_header_data_xpos></group_header_data_xpos><group_trailer_label>0</group_trailer_label></Format></QueryColumn><QueryColumn><Name>item_name</Name><TableName>l</TableName><ColumnName>item_name</ColumnName><ColumnType>char</ColumnType><ColumnLength>30</ColumnLength><Format><column_display>show</column_display><content_type>plain</content_type><ColumnStartPDF></ColumnStartPDF><justify>left</justify><ColumnWidthPDF></ColumnWidthPDF><ColumnWidthHTML></ColumnWidthHTML><column_title>Malın adı</column_title><tooltip></tooltip><group_header_label>0</group_header_label><group_header_label_xpos></group_header_label_xpos><group_header_data_xpos></group_header_data_xpos><group_trailer_label>0</group_trailer_label></Format></QueryColumn><QueryColumn><Name>f_count</Name><TableName>l</TableName><ColumnName>f_count</ColumnName><ColumnType>char</Col