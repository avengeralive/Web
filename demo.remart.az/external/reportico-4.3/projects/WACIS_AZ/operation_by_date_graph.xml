  FROM  nf_operations no
WHERE no.operation_type_id = 5
UNION ALL 
SELECT  date(no.change_date) date, NULL, NULL, NULL, NULL, NULL, no.count as inventarisation  ,  NULL ,NULL
  FROM  nf_operations no
WHERE no.operation_type_id = 6
UNION ALL 
SELECT  date(no.change_date) date, NULL, NULL, NULL, NULL, NULL , NULL, no.count as migration   , NULL 
  FROM  nf_operations no
WHERE no.operation_type_id = 8
UNION ALL 
SELECT  date(no.change_date) date, NULL, NULL, NULL, NULL, NULL , NULL,  NULL , no.count as CASH  
  FROM  nf_operations no
WHERE no.operation_type_id = 9
) t where  1   [ AND  date between {DateInterval,RANGE1} and {DateInterval,RANGE2} ] 
