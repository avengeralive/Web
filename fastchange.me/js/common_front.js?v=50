$(document).on("submit", ".change_form", function (e) {
    var method_type = $('.change_form').attr('method');
    var action_type = $('.change_form').attr('action');
    var data_serial = $('.change_form').serialize();
    var val_inp1 = $('#hidden_inp').val();
    var val_inp2 = $('#hidden_inp_two').val();
    if (val_inp1 == 0 || val_inp2 == 0) {
        $('#error_modal_text').arcticmodal({overlay: {css: {opacity: .70}}, closeOnOverlayClick: 1, beforeOpen: function(){blur_enable();}, beforeClose:function(){blur_disable();}});
        $('#error_modal_text').find('.text').html('Вы не выбрали направление обмена. Пожалуйста, выберите направление обмена и повторте попытку.');
    } else {
        $.ajax({
            type: method_type,
            url: action_type,
            data: data_serial,
            resetForm: 'true',
            success: function (successRes) {
                csrfHash = successRes.csrf.csrfHash;
                $("input[name='csrf_fast']").val(successRes.csrf.csrfHash);
                $('#cap_img').html(successRes.cap);
                $('#add_app_hash').val(successRes.hash);

                if (successRes['status'] == 1) {
                    application_id = successRes['application_id'];
                    if (val_inp1 == 1) {
                        $('.link_numeric').attr('href', '/perfect/send/' + application_id);
                    }
                    if (val_inp1 == 16) {
                        $('.link_numeric').attr('href', '/payeer/send/' + application_id);
                    }
                    if (val_inp1 == 17) {
                        $('.link_numeric').attr('href', '/okpay/send/' + application_id);
                    }
                    if (val_inp1 == 21) {
                        $('.link_numeric').attr('href', '/adv/send/' + application_id);
                    }

                   if (successRes['veryfication'] == 1) {
                        $('#verification_modal').arcticmodal({overlay: {css: {opacity: .70}}, closeOnOverlayClick: 1, beforeOpen: function(){blur_enable();}, beforeClose:function(){blur_disable();}});
                        return true;
                    } else if (successRes['veryfication'] == 2) {
                        $('#verification_qiwi').arcticmodal({overlay: {css: {opacity: .70}}, closeOnOverlayClick: 1, beforeOpen: function(){blur_enable();}, beforeClose:function(){blur_disable();}});
                        return true;
                    } else {
                        finished_step();
                    }
                }
            },
            error: function (errResult) {
                var error_text = '';
                var errArr = errResult.responseJSON.fields;
                csrfHash = errResult.responseJSON.csrf_hash;
                $("input[name='csrf_fast']").val(errResult.responseJSON.csrf_hash);

                $.each(errArr, function (index, value) {
                    if (value != 0) {
                        error_text += value;
                        $('#' + index + '').parents('.inputs_right').addClass('error_message');
                    } else {
                        $('#' + index + '').parents('.inputs_right').removeClass('error_message');
                    }
                });

                $('#error_modal_text').arcticmodal({overlay: {css: {opacity: .70}}, closeOnOverlayClick: 1, beforeOpen: function(){blur_enable();}, beforeClose:function(){blur_disable();}});
                $('#error_modal_text').find('.text').html(error_text);
            },
            dataType: "json"
        });
    }
    e.preventDefault();
    return false;
});

