function calculation(numeric, inp_val) {
    comsa = 0;
    var select_val1 = Number($('#hidden_inp').val());
    var select_val2 = Number($('#hidden_inp_two').val());
    var change_kurs = Number(rate_cahange[select_val1][select_val2]);
    var kurs_first_one = Number(valute_kurs[select_val1][select_val2]);
    var kurs_first_two = Number(valute_kurs[select_val2][select_val1]);
    var kurs_second_one = Number(valute_kurs_second[select_val1][select_val2]);
    var kurs_second_two = Number(valute_kurs_second[select_val2][select_val1]);
    var give_cahrcode = charcode[select_val1];
    var receive_cahrcode = charcode[select_val2];
    var summ = 0;
    var kurs = 0;
    var valuta_kurs_one = kurs_first_one > kurs_second_one ? kurs_first_one : kurs_second_one;
    var valuta_kurs_two = kurs_first_two < kurs_second_two ? kurs_first_two : kurs_second_two;

    if (typeof commission[select_val2] != "undefined") {
        comsa = commission[select_val2];
    }

    if (!inp_val) {
        if (valuta_kurs_two >= 1) {
            kurs = valuta_kurs_two - (valuta_kurs_two * (change_kurs + comsa) / 100);
            summ = (numeric * kurs);
        } else {
            kurs = valuta_kurs_one + (valuta_kurs_one * (change_kurs + comsa) / 100);
            summ = (numeric / kurs);
        }

        $("#give_money_hidden").val(numeric);
        $("#receive_money_hidden").val(summ);

        if (receive_cahrcode == "BTC" || receive_cahrcode == "LTC" || receive_cahrcode == "ETH" || receive_cahrcode == "DSH" || receive_cahrcode == "BCH" || receive_cahrcode == "XMR" || receive_cahrcode == "ZEC") {
            summ = Number(summ).toFixed(8);
        } else {
            summ = Number(summ).toFixed(2);
        }
    }
    else {
        if (valuta_kurs_two >= 1) {
            kurs = valuta_kurs_two - (valuta_kurs_two * (change_kurs + comsa) / 100);
            summ = (numeric / kurs);
        } else {
            kurs = valuta_kurs_one + (valuta_kurs_one * (change_kurs + comsa) / 100);
            summ = (numeric * kurs);
        }

        $("#give_money_hidden").val(summ);
        $("#receive_money_hidden").val(numeric);

        if (give_cahrcode == "BTC" || give_cahrcode == "LTC" || give_cahrcode == "ETH" || give_cahrcode == "DSH" || give_cahrcode == "BCH" || give_cahrcode == "XMR" || give_cahrcode == "ZEC") {
            summ = Number(summ).toFixed(8);
        } else {
            summ = Number(summ).toFixed(2);
        }
    }
    return (summ);
}

function fixator_func(select_val1, select_val2) {
    if (select_val1 != 0 && select_val2 != 0) {
        $.ajax({
            type: 'POST',
            url: '/front/fix_kurs',
            data: {'csrf_fast' : csrfHash, 'give_radio': select_val1, 'receive_radio': select_val2},
            resetForm: 'true',
            success: function (successRes) {
                csrfHash = successRes.csrf.csrfHash;
                $("input[name='csrf_fast']").val(successRes.csrf.csrfHash);
                $("#fix_kurs").val(successRes['id']);
