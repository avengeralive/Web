function calc_kurs(num_one, num_two) {
    comsa = 0;
    if (!num_one) {
        return false;
    }

    if (!num_two) {
        return false;
    }

    var kurs_value = Number(rate_cahange[num_one][num_two]);

    var result_kurs1 = 0;
    var result_kurs2 = 0;

    var kurs_first_one = Number(valute_kurs[num_one][num_two]);
    var kurs_first_two = Number(valute_kurs[num_two][num_one]);
    var kurs_second_one = Number(valute_kurs_second[num_one][num_two]);
    var kurs_second_two = Number(valute_kurs_second[num_two][num_one]);

    var valuta_kurs_one = kurs_first_one > kurs_second_one ? kurs_first_one : kurs_second_one;
    var valuta_kurs_two = kurs_first_two < kurs_second_two ? kurs_first_two : kurs_second_two;

    var give_cahrcode = charcode[num_one];
    var receive_cahrcode = charcode[num_two];

    if (typeof commission[num_two] != "undefined") {
        comsa = commission[num_two];
    }

    var result_kurs = "";

    if (valuta_kurs_one > valuta_kurs_two) {
        result_kurs1 = 1;
        result_kurs2 = valuta_kurs_one + (valuta_kurs_one * (kurs_value + comsa) / 100);
        if (result_kurs1 != result_kurs2) {
            //result_kurs2 = Number(result_kurs2).toFixed(4);
            if (give_cahrcode == "RUR") {
                result_kurs2 = Number(result_kurs2).toFixed(2);
            } else if (receive_cahrcode == "USD") {
                result_kurs2 = Number(result_kurs2).toFixed(2);
            }
            else if (receive_cahrcode == "BTC") {
                result_kurs2 = Number(result_kurs2).toFixed(8);
            }
            else if (receive_cahrcode == "LTC") {
                result_kurs2 = Number(result_kurs2).toFixed(8);
            }
            else if (receive_cahrcode == "ETH") {
                result_kurs2 = Number(result_kurs2).toFixed(8);
            }
            else if (receive_cahrcode == "DSH") {
                result_kurs2 = Number(result_kurs2).toFixed(8);
            }
            else if (receive_cahrcode == "BCH") {
                result_kurs2 = Number(result_kurs2).toFixed(8);
            }
            else if (receive_cahrcode == "XMR") {
                result_kurs2 = Number(result_kurs2).toFixed(8);
            }
            else if (receive_cahrcode == "ZEC") {
                result_kurs2 = Number(result_kurs2).toFixed(8);
            }
        }
        if (result_kurs1 >= result_kurs2) {
            result_kurs = result_kurs1 + ' ' + receive_cahrcode + ' = ' + result_kurs2 + ' ' + give_cahrcode;
        } else {
            result_kurs = result_kurs2 + ' ' + give_cahrcode + ' = ' + result_kurs1 + ' ' + receive_cahrcode;
        }
    } else if (valuta_kurs_one < valuta_kurs_two) {
        result_kurs1 = 1;
        result_kurs2 = valuta_kurs_two - (valuta_kurs_two * (kurs_value + comsa) / 100);
        if (result_kurs1 != result_kurs2) {
            // result_kurs2 = Number(result_kurs2).toFixed(4);
            if (receive_cahrcode == "RUR") {
                result_kurs2 = Number(result_kurs2).toFixed(2);
            } else if (receive_cahrcode == "USD") {
                result_kurs2 = Number(result_kurs2).toFixed(2);
            }
            else if (receive_cahrcode == "BTC") {
                result_kurs2 = Number(result_kurs2).toFixed(8);
            }
            else if (receive_cahrcode == "LTC") {
                result_kurs2 = Number(result_kurs2).toFixed(8);
            }
            else if (receive_cahrcode == "ETH") {
                result_kurs2 = Number(result_kurs2).toFixed(8);
