function update_kurs() {
    if (fixator == 0) {
        fixator = 1;
        setTimeout(
            function () {
                fixator = 0;
            }, 600000
        );
    }

    $.ajax({
        type: 'post',
        url: '/front/valute_check',
        data: {'csrf_fast' : csrfHash},
        resetForm: 'true',
        success: function (res) {
            csrfHash = res.csrf.csrfHash;
            $("input[name='csrf_fast']").val(res.csrf.csrfHash);
            var act = res;
            var kurs_array_first = act[1];
            var kurs_array_second = act[2];
            var kurs_change_array = act[3];

            var select_val1 = $('#hidden_inp').val();
            var select_val2 = $('#hidden_inp_two').val();

            fixator_func(select_val1, select_val2);

            var valute_kurs_first_original = valute_kurs[select_val1][select_val2];
            var valute_kurs_first_new = kurs_array_first[select_val1][select_val2];

            var valute_kurs_second_original = valute_kurs_second[select_val1][select_val2];
            var valute_kurs_second_new = kurs_array_second[select_val1][select_val2];

            var change_kurs_first_original = rate_cahange[select_val1][select_val2];
            var change_kurs_first_new = kurs_change_array[select_val1][select_val2];

            if ((valute_kurs_first_original != valute_kurs_first_new) ||
                (valute_kurs_second_original != valute_kurs_second_new) ||
                (change_kurs_first_original != change_kurs_first_new)
            ) {
                valute_kurs = kurs_array_first;
                valute_kurs_second = kurs_array_second;
                rate_cahange = kurs_change_array;

                calc_kurs(select_val1, select_val2);
                $('.receive_money').val(calculation($('.give_money').val(), 0));
                $('#kurs_main').css('color', '#fade43');
                $('#kurs_main').animate({color: "#222"}, 15000);
            }
        },
        dataType: 'json',
        error: function (XMLHttpRequest) {
            console.log("Не удалось обновить курсы");
        }
    });
}

