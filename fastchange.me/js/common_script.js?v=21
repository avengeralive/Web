$(document).on("submit", "#rezerv_form", function () {
    var obj_rezerv_form = $(this);
    $.ajax({
        type: obj_rezerv_form.attr('method'),
        url: obj_rezerv_form.attr('action'),
        data: obj_rezerv_form.serialize(),
        resetForm: 'true',
        success: function (res) {
            csrfHash = res.csrf.csrfHash;
            $("input[name='csrf_fast']").val(res.csrf.csrfHash);
            $('#cap_img2').html(res.cap);
            $('#rezerv_window').arcticmodal('close');
            $('#info_text_popup').html('<p>Вы успешно создали заявку на пополнение резерва</p><p>Наш оператор свяжется с вами в ближайшее время. </p>');
