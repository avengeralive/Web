$('#file_select_button').add($("#file_select_verifi")).click(function() {
    $('.upload_bar_container .upload_bar').css('width', '0%');
    $('#progress_upload').css('display', 'none');
    $('#fileupload').click().change(function() {
        var lastIndexOfSep = this.value.lastIndexOf('\\'); // Windows
        if (lastIndexOfSep == -1)
            lastIndexOfSep = this.value.lastIndexOf('/'); // Linux
        var fileName = this.value.substring(lastIndexOfSep + 1, this.length);
        $("#file_select_verifi").text(fileName);
    });
});
/* --- стилизация input`а для загрузки файла --- */


$('#fileupload').fileupload({
    dataType: 'json',
    done: function (e, data) {
        //console.log(data.result.success.upload_data.file_name);
        console.log(data.result);
        if (data.result.err == 1) {
            $('#error_modal_text').arcticmodal({overlay: {css: {opacity: .70}}, closeOnOverlayClick: 1, beforeOpen: function(){blur_enable();}, beforeClose:function(){blur_disable();}});
            $('#error_modal_text').find('.text').html('<p>Ошибка загрузки файла. Вероятно файл весит больше 5 Мб</p>');
            $('#progress_upload').css('display', 'none');
            $('.upload_bar_container .upload_bar').css('width', 0);
            $('#file_success').text(0);
        } else {
            $('#progress_upload').css('display', 'block');
            $('.upload_bar_container .upload_bar').text('Файл успешно загружен');
            $('#file_success').val(data.result.success.upload_data.file_name);
        }
        csrfHash = data.result.csrf.csrfHash;
        $("input[name='csrf_fast']").val(data.result.csrf.csrfHash);
    },
    progressall: function (e, data) {
        var progress = parseInt(data.loaded / data.total * 100, 10);
        $('.upload_bar_container .upload_bar').css('display', 'block');
        $('.upload_bar_container .upload_bar').text('Загрузка: ' + progress + '%');
        $('.upload_bar_container .upload_bar').css('width', progress + '%');
    }

});


function verification_wait(id) {
    $.ajax({
        type: 'post',
        url: '/front/wait_verification',
        data: {'csrf_fast' : csrfHash, 'id_ver': id},
        resetForm: 'true',
        success: function (result) {
            csrfHash = result.csrf.csrfHash;
            $("input[name='csrf_fast']").val(result.csrf.csrfHash);
            if (result['status'] == 1) {
                $('.file_upload .file_select').text('Выберите файл');
                $('#file_success').val('');
                $('#fio').val('');
                $('#kardnum').val('');

                $('#info_text_popup').html('<p>Вы успешно прошли верификацию!</p>');
                $('#info_popup').arcticmodal({overlay: {css: {opacity: .85}}, closeOnOverlayClick: 0});
                $('#verification_wait').arcticmodal('close');
                clearInterval(loadresVerification);
            }
        },
        error: function (errResult) {
            var error_text = '';
            var errArr = errResult.responseJSON.fields;
            csrfHash = errResult.responseJSON.csrf_hash;
            $("input[name='csrf_fast']").val(errResult.responseJSON.csrf_hash);

            $('.file_upload .file_select').text('Выберите файл');
            $('#file_success').val('');
            $('#fio').val('');
            $('#kardnum').val('');

            $.each(errArr, function (index, value) {
                if (value != 0) {
                    error_text += value;
                    $('#' + index + '').parents('.inputs_right').addClass('error_message');
                } else {
                    $('#' + index + '').parents('.inputs_right').removeClass('error_message');
                }
            });

            $('#err_title_popup').text(errResult.responseJSON.message);
            $('#error_modal_text').find('.text').html(error_text);
            $('#error_modal_text').arcticmodal({overlay: {css: {opacity: .70}}, closeOnOverlayClick: 1, beforeOpen: function(){blur_enable();}, beforeClose:function(){blur_disable();}});
            $('#verification_wait').arcticmodal('close');
            clearInterval(loadresVerification);
        },
        dataType: "json"
    });
    return false;
}
