function nospace(str) {
    var VResult = str.replace(/\s/g, '');
    return VResult;
}

function roundPlus(x, n) { //x - число, n - количество знаков
    if (isNaN(x) || isNaN(n)) return false;
    var m = Math.pow(10, n);
    return Math.round(x * m) / m;
}

function calculate() {

    let investor_profit = 0;
    let value_summ_number = Number(nospace(value_summ));

    if (+value_month === 1) {
        investor_profit = 0.25;
    } else {
        investor_profit = 0.50;
    }

    var value_resultProcent = 0;

    for (i = 1; i <= value_month; i++) {
        if (i === 1) {
            value_resultProcent = value_resultProcent + average_income * 0.25;
        } else {
            value_resultProcent = value_resultProcent + average_income * investor_profit;
        }

    }

    /*  console.log(
     `${value_resultProcent} * 100 * ${value_month} - ${value_resultProcent} * 100 = ${roundPlus(value_resultProcent * 100 * value_month - value_resultProcent * 100, 2) + " %"}`
     )

     console.log(
     `${value_summ_number} * ${value_resultProcent} * ${value_month}  - ${value_summ_number} * ${value_resultProcent}  = ${Math.round(value_summ_number * value_resultProcent * value_month - value_summ_number * value_resultProcent) + "  ₽"}`
     )*/

    $('.calculate__percent').text(roundPlus(value_resultProcent * 100, 2) + ' %');
    $('.calculate__summ').text(Math.round(value_summ_number * value_resultProcent) + '  ₽');

}

var chartProcent;
var chartMoney;
var chartindex;

$.getJSON('./json/charts.json', function(data) {
    chartProcent = JSON.parse(data.chartProcent);
    chartMoney = JSON.parse(data.chartMoney);
    chart();
});

function chart() {
    var ctx = document.getElementById('chart');
    // var ctx2 = document.getElementById('chart2');
    var customTooltips = function(tooltip) {
        var tooltipEl = document.getElementById('chartjs-tooltip');
        if (!tooltipEl) {
            tooltipEl = document.createElement('div');
            tooltipEl.id = 'chartjs-tooltip';
            tooltipEl.innerHTML = '<table></table>';
            this._chart.canvas.parentNode.appendChild(tooltipEl);
        }
        if (tooltip.opacity === 0) {
            tooltipEl.style.opacity = 0;
            return;
        }
        tooltipEl.classList.remove('above', 'below', 'no-transform');
        if (tooltip.yAlign) {
            tooltipEl.classList.add(tooltip.yAlign);
        } else {
            tooltipEl.classList.add('no-transform');
        }

        function getBody(bodyItem) {
            return bodyItem.lines;
        }

        if (tooltip.body) {
            var titleLines = tooltip.title || [];
            var bodyLines = tooltip.body.map(getBody);

            var innerHtml = '<thead>';

            titleLines.forEach(function() {
                innerHtml += '<tr><th>' + chartProcent[chartindex] + '%</th></tr>';
            });
            innerHtml += '</thead><tbody>';

            innerHtml += '</tbody>';

            var tableRoot = tooltipEl.querySelector('table');
            tableRoot.innerHTML = innerHtml;
        }

        var positionY = this._chart.canvas.offsetTop;
        var positionX = this._chart.canvas.offsetLeft;

        // Display, position, and set styles for font
        tooltipEl.style.opacity = 1;
        tooltipEl.style.left = positionX + tooltip.caretX + 'px';
        tooltipEl.style.top = positionY + tooltip.caretY + 'px';
    };

    var myChart = new Chart(ctx, {
        type: 'line',
        data: {
            labels: [' ', ' ', ' ', ' ', ' ', ' ', ' ', ' ', ' ', ' ', ' ', ' '],
            datasets: [
                {
                    data: chartProcent,
                    backgroundColor: 'rgba(255, 99, 132, 0)',
                    borderColor: '#ffed01',
                    borderWidth: 5,
                    pointBackgroundColor: '#000',
                    pointBorderColor: '#fff',
                    pointBorderWidth: 3,
                    pointHoverBorderWidth: 3,
                    pointRadius: 6,
                    pointHoverRadius: 6
                }]

        },
        options: {
            maintainAspectRatio: false,
            responsive: true,
            legend: {
                display: false
            },
            tooltips: {
                callbacks: {
                    label: function(tooltipItem, data) {
                        chartindex = tooltipItem.index;
                    }
                },
                enabled: false,
                mode: 'index',
                position: 'nearest',
                custom: customTooltips

            },
            scales: {
                yAxes: {
                    ticks: {
                        fontSize: 0
                    }
                }
            }
        }
    });

}

