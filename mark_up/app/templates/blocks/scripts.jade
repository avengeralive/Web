// Scripts for map
script(src="https://maps.googleapis.com/maps/api/js?v=3.exp&amp;sensor=false")
script.
	var map;
	function initialize() {
		var mapOptions = {
			zoom: 5,
			center: new google.maps.LatLng(55.772089, 37.592534),
			zoomControl: false,
			zoomControlOptions: {
				style: google.maps.ZoomControlStyle.SMALL
			},
			disableDefaultUI: true
		};
		var styles = [
			{
				"stylers": [
					{ "saturation": -75 },
					{ "lightness": -55 }
				]
			}
		]
		var styledMap = new google.maps.StyledMapType(styles, {name: "Styled Map"});
		map = new google.maps.Map(document.getElementById('map-canvas'), mapOptions);
		map.mapTypes.set('map_style', styledMap);
		map.setMapTypeId('map_style');
		var image = 'img/map-logo.png';

		var myLatLng0 = new google.maps.LatLng(55.773089, 37.591534);
		var beachMarker = new google.maps.Marker({
			position: myLatLng0,
			map: map,
			icon: image
		});

		var myLatLng1 = new google.maps.LatLng(59.96907, 30.309144);
		var beachMarker = new google.maps.Marker({
			position: myLatLng1,
			map: map,
			icon: image
		});

		var myLatLng2 = new google.maps.LatLng(38.032098, -78.470734);
		var beachMarker = new google.maps.Marker({
			position: myLatLng2,
			map: map,
			icon: image
		});

		var myLatLng3 = new google.maps.LatLng(46.3756968,48.0497982);
		var beachMarker = new google.maps.Marker({
			position: myLatLng3,
			map: map,
			icon: image
		});

		var myLatLng4 = new google.maps.LatLng(51.8201356,107.6584025);
		var beachMarker = new google.maps.Marker({
			position: myLatLng4,
			map: map,
			icon: image
		});
	}
	google.maps.event.addDomListener(window, 'load', initialize);
