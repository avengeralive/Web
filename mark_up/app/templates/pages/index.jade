	section.section-block.development-stages-block
		.container
			h1.section-header-dark этапы разработки приложения
			ol.development-stages
				li.development-stages--stage
					.development-stages--stage-image: img(src="img/stages/1.png" alt="")
					.development-stages--stage-content
						h2.development-stages--stage-head 1. Идея проекта и консультация
						p.development-stages--stage-text Люди приходят к нам в компанию, чтобы воплотить в жизнь свои идеи или автоматизировать бизнес-процессы. Мы предоставляем бесплатную консультацию у аналитика InfoShell и доработку идейной составляющей проекта.
					img.idea(src="img/stages/idea.png" width="107" height="112")
				li.development-stages--stage
					.development-stages--stage-image: img(src="img/stages/2.png" alt="")
					.development-stages--stage-content
						h2.development-stages--stage-head 2. Оценка проекта и предложение
						p.development-stages--stage-text Оценку проекта произодит команда разработчиков. После чего клиент получает предварительное коммерческое предложение на разработку продукта.
				li.development-stages--stage
					.development-stages--stage-image: img(src="img/stages/3.png" alt="")
					.development-stages--stage-content
						.relative
							h2.development-stages--stage-head 3. Бэклог и договор
							.tooltip
								span ?
								.tooltip-content.
									#[b Продукт-оунер] — руководитель проекта.#[br]
									#[b Бэклог] — список задач для команды разработки, которые полностью описывают проект.
						p.development-stages--stage-text Встреча с продукт-оунером, обсуждение деталей проекта. Команда разрабатывает бэклог на весь проект совместно с заказчиком. После утверждения бэклога, с заказчиком подписывается договор.
				li.development-stages--stage-preinner
					.development-stages--stage-image: img(src="img/stages/4.png" alt="")
					.development-stages--stage-content
						.relative
							h2.development-stages--stage-head 4. Планирование спринта
							.tooltip
								span ?
								.tooltip-content.
									#[b Спринт] — этап в рамках которого реализуется определенная часть проекта
						p.development-stages--stage-text Договоренность с заказчиком о том какие задачи будут выполнены на ближайшем спринте.
				li.development-stages--stage-inner
					.development-stages--stage-arrow-up проект пока #[br]не завершен
					.development-stages--stage-arrow-down
					.development-stages--stage-image: img(src="img/stages/5.png" alt="")
					.development-stages--stage-content
						h2.development-stages--stage-head 5. ретроспектива
						p.development-stages--stage-text Демонстрация заказчику результатов за неделю. Команда анализирует риски и проблемы, завершает спринт, оптимизирует дальнейший процесс разработки.
					.clock
						img(src="img/stages/clock.png", alt="", width="99" height="78")
						b 24 часа
						span Каждый день команда отчитывается продукт-оунеру о выполненных задачах.
				li.development-stages--stage-last
					.development-stages--stage-last-arrow-down проект завершен
					.development-stages--stage-image: img(src="img/stages/6.png" alt="")
					.development-stages--stage-content
						h2.development-stages--stage-head 6. Завершение
						p.development-stages--stage-text Клиент получачет отменный готовый продукт, который можно использовать по назначению.
