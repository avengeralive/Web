<?xml version="1.0"?><Report><ReportQuery><Format><ReportTitle>Qaimə üzrə borc</ReportTitle><ReportDescription></ReportDescription><PageSize>.DEFAULT</PageSize><PageOrientation>.DEFAULT</PageOrientation><TopMargin></TopMargin><BottomMargin></BottomMargin><RightMargin></RightMargin><LeftMargin></LeftMargin><pdfFont></pdfFont><pdfFontSize></pdfFontSize><PreExecuteCode>NONE</PreExecuteCode><formBetweenRows>solidline</formBetweenRows><bodyDisplay>show</bodyDisplay><graphDisplay>show</graphDisplay><gridDisplay>.DEFAULT</gridDisplay><gridSortable>.DEFAULT</gridSortable><gridSearchable>.DEFAULT</gridSearchable><gridPageable>.DEFAULT</gridPageable><gridPageSize>.DEFAULT</gridPageSize></Format><Datasource><SourceType>database</SourceType><SourceConnection><DatabaseType>mysql</DatabaseType><DatabaseName></DatabaseName><HostName></HostName><ServiceName></ServiceName><UserName></UserName><Password></Password></SourceConnection></Datasource><EntryForm><Query><TableSql></TableSql><WhereSql></WhereSql><GroupSql></GroupSql><RowSelection>all</RowSelection><SQL><QuerySql></QuerySql><SQLRaw>SELECT m.id qaime_nomre , m.full_name, m.sum_qaime, m.odenilib_qaime, (m.sum_qaime-m.odenilib_qaime)  borc , m.reg_date, m.change_date,m.status
 FROM ( 
SELECT t.*, COALESCE(SUM(fo.amount_ncur),0) odenilib_qaime,  CONCAT( hc.name,  ' ', hc.last_name,  ' ', hc.father_name ) as   full_name FROM ( 
	SELECT sp.id ,no.receiver , SUM(no.total_amount) sum_qaime, sp.reg_date, sp.change_date ,  sp.status
	 FROM  `s_packages`  sp  , `nf_operations` no 
	  WHERE 1 
            [ AND sp.reg_date between {periodDate,RANGE1} and {periodDate,RANGE2} ]  
	   AND  no.package_id = sp.id
	   GROUP BY sp.id, no.receiver
 ) t 
 LEFT JOIN `f_operations` fo 
  ON fo.package_id = t.id  and fo.operation_type_id = 4 
 LEFT JOIN h_contractors hc 
   ON hc.id = t.receiver
  GROUP BY t.id ) m WHERE 1</SQLRaw></SQL><QueryColumns><QueryColumn><Name>qaime_nomre</Name><TableName>m</TableName><ColumnName>id</ColumnName><ColumnType>char</ColumnType><ColumnLength>30</ColumnLength><Format><column_display>show</column_display><content_type>plain</content_type><ColumnStartPDF></ColumnStartPDF><justify>left</justify><ColumnWidthPDF></ColumnWidthPDF><ColumnWidthHTML></ColumnWidthHTML><column_title>Qaimənin nömrəsi</column_title><tooltip></tooltip><group_header_label></group_header_label><group_header_label_xpos></group_header_label_xpos><group_header_data_xpos></group_header_data_xpos><group_trailer_label></group_trailer_label></Format></QueryColumn><QueryColumn><Name>full_name</Name><TableName>m</TableName><ColumnName>full_name</ColumnName><ColumnType>char</ColumnType><ColumnLength>30</ColumnLength><Format><column_display>show</column_display><content_type>plain</content_type><ColumnStartPDF></ColumnStartPDF><justify>left</justify><ColumnWidthPDF></ColumnWidthPDF><ColumnWidthHTML></ColumnWidthHTML><column_title>Kontragent</column_title><tooltip></tooltip><group_header_label></group_header_label><group_header_label_xpos></group_header_label_xpos><group_header_data_xpos></group_header_data_xpos><group_trailer_label></group_trailer_label></Format></QueryColumn><QueryColumn><Name>sum_qaime</Name><TableName>m</TableName><ColumnName>sum_qaime</ColumnName><ColumnType>char</ColumnType><ColumnLength>30</ColumnLength><Format><column_display>show</column_display><content_type>plain</content_type><ColumnStartPDF></ColumnStartPDF><justify>left</justify><ColumnWidthPDF></ColumnWidthPDF><ColumnWidthHTML></ColumnWidthHTML><column_title>Qaimə məbləği</column_title><tooltip></tooltip><group_header_label></group_header_label><group_header_label_xpos></group_header_label_xpos><group_header_data_xpos></group_header_data_xpos><group_trailer_label></group_trailer_label></Format></QueryColumn><QueryColumn><Name>odenilib_qaime</Name><TableName>m</TableName><ColumnName>o