SELECT  date(no.change_date) date,no.count as reservation , NULL as unreservation , NULL as retail, NULL as income, NULL as outgo, NULL as inventarisation, NULL  as migration ,NULL   as cash
  FROM  nf_operations no
WHERE no.operation_type_id = 1 
UNION ALL 
SELECT  date(no.change_date) date, NULL, no.count as unreservation  , NULL , NULL, NULL, NULL, NULL ,NULL 
  FROM  nf_operations no
WHERE no.operation_type_id = 2  
UNION ALL 
