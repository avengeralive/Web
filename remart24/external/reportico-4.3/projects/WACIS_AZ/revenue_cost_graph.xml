 date(reg_date) process_day , SUM(INCOME) income, SUM(OUTGO) outgo FROM 
(select 
if(debet=sc.value,concat('+',amount_ncur),-1*amount_ncur) INCOME,NULL  OUTGO,
t1.reg_date
from f_operations t1, s_operations_types t2, s_configuration sc
where reg_date is not null and (debet = sc.value ) and
  t1.operation_type_id = t2.id and sc.id = 8 
UNION ALL 
select 
NULL,if(credit=sc.value,concat('+',amount_ncur),-1*amount_ncur)  OUTGO,
t3.reg_date
from f_operations t3, s_operations_types t4 , s_configuration sc
where reg_date is not null and ( credit = sc.value) and
  t3.operation_type_id = t4.id and sc.id = 8  and reg_date &gt; CURDATE() -30 
) t5 WHERE 1 
 [ AND date(reg_date) between {DateInterval,RANGE1} and {DateInterval,RANGE2} ] 
group by date(reg_date)</SQLRaw></SQL><QueryColumns><QueryColumn><Name>process_day</Name><TableName></TableName><ColumnName>date(reg_date)</ColumnName><ColumnType>char</ColumnType><ColumnLength>30</ColumnLength><Format><column_display>show</column_display><content_type>plain</content_type><ColumnStartPDF></ColumnStartPDF><justify>left</justify><ColumnWidthPDF></ColumnWidthPDF><ColumnWidthHTML></ColumnWidthHTML><column_title></column_title><tooltip></tooltip><group_header_label>0</group_header_label><group_header_label_xpos></group_header_label_xpos><group_header_data_xpos></group_header_data_xpos><group_trailer_label>0</group_trailer_label></Format></QueryColumn><QueryColumn><Name>income</Name><TableName></TableName><ColumnName>SUM(INCOME)</ColumnName><ColumnType>char</ColumnType><ColumnLength>30</ColumnLength><Format><column_display>show</column_display><content_type>plain</content_type><ColumnStartPDF></ColumnStartPDF><justify>left</justify><ColumnWidthPDF></ColumnWidthPDF><ColumnWidthHTML></ColumnWidthHTML><column_title></column_title><tooltip></tooltip><group_header_label>0</group_header_label><group_header_label_xpos></group_header_label_xpos><group_header_data_xpos></group_header_data_xpos><group_trailer_label>0</group_trailer_label></Format></QueryColumn><QueryColumn><Name>outgo</Name><TableName></TableName><ColumnName>SUM(OUTGO)</ColumnName><ColumnType>char</ColumnType><ColumnLength>30</ColumnLength><Format><column_display>show</column_display><content_type>plain</content_type><ColumnStartPDF></ColumnStartPDF><justify>left</justify><ColumnWidthPDF></ColumnWidthPDF><ColumnWidthHTML></ColumnWidthHTML><column_title></column_title><tooltip></tooltip><group_header_label>0</group_header_label><group_header_label_xpos></group_header_label_xpos><group_header_data_xpos></group_header_data_xpos><group_trailer_label>0</group_trailer_label></Format></QueryColumn></QueryColumns><OrderColumns></OrderColumns><PreSQLS></PreSQLS></Query><Assignments></Assignments><Criteria><