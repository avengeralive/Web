  </head>
  <body>
    {{ application.showAdminPanel() }}
    <div class="top-line">
      <div class="row show-for-medium">
        <div class="medium-16 large-10 column">
		  {% widget 'MenuUser' with { alias:'top' } %}
          <br class="hide-for-large">
        </div>
        <div class="medium-8 large-14 text-right column">
          <ul class="menu align-right">
		    {% set status_bar %}
				{% if user %}
				<li><a href="/cms/logout.php"><span class="show-for-large"><i class="fa fa-sign-out"></i>&#160; Выход</span><span class="hide-for-large"><i class="fa fa-lg fa-sign-out"></i></span></a></li>
				<li><a href="/personal/"><span class="show-for-large"><i class="fa fa-user"></i>&#160; {{ user.login }}</span><span class="hide-for-large"><i class="fa fa-lg fa-user"></i></span></a></li>
				<li><a href="/personal/wishlist">
					<span class="show-for-large"><i class="fa fa-heart-o"></i>&nbsp; {{ _('Любимые товары') }}: <span class="x-wishlist-count">{{ user.getWishList().getProductsCount() }}</span></span>
					<span class="hide-for-large"><i class="fa fa-lg fa-heart-o"></i>&nbsp; <span class="x-wishlist-count">{{ user.getWishList().getProductsCount() }}</span></span></a>
				</li>
				{% else %}
				<li><a href="/login/">
					<span class="show-for-large"><i class="fa fa-sign-in"></i>&#160; {{ _('Войти') }}</span>
					<span class="hide-for-large"><i class="fa fa-lg fa-sign-in"></i></span>
				</a></li>
				{% endif %}
				<li>{% widget 'Sale.Cart.Line' with { path_to_cart: '/cart/' } %}</li>
			{% endset %}
			{{ status_bar }}
          </ul>
        </div>
      </div>
      <div class="row show-for-small-only text-center column">
		<a href="tel:{{ config.phone }}" title="тел.:"><i class="fa fa-phone fa-lg"></i><b>&#160; {{ config.phone }}</b></a>
		<br><a href="mailto:{{ config.email }}"><i class="fa fa-envelope fa-lg"></i><b>&#160; {{ config.email }}</b></a>
	  </div>
    </div>
    <div class="row">
      <div class="small-20 medium-8 large-6 column">
        <p class="medium-text-center"><a href="/"><img src="{% if config.logo %}{{ config.logo }}{% else %}{{ basePath }}/images/image.svg{% endif %}" alt="{{ server.name }}" class="header-logo-image"></a></p>
      </div>
      <div class="small-4 hide-for-medium column"><a href="#" title="{{ _('Меню') }}" data-toggle="red-line"><i class="fa fa-3x fa-bars"></i></a></div>
      <div class="show-for-medium medium-8 large-offset-1 column">
        <p class="header-center-column">
			<a href="tel:{{ config.phone|phone }}" title="тел.:"><b class="lead"><i class="fa fa-lg fa-phone-square">&#160;</i>{{ config.phone }}</b></a>
			<br><a href="mailto:{{ config.email }}"><b class="lead"><i class="fa fa-envelope"></i>&#160;{{ config.email }}</b></a>
			<br>Пн-Пт 8:00—20:00
		</p>
      </div>
      <div class="small-24 medium-8 large-6 large-offset-1 column header-search-field">
        <form method="get" action="/search" data-abide="" novalidate="novalidate">
          <div style="margin-bottom: 0;" class="input-group">
            <input type="text" placeholder="Поиск" name="query" required="" class="input-group-field">
            <div class="input-group-button">
              <button type="submit" class="button secondary"><i class="fa fa-search fa-inverse"></i></button>
            </div>
          </div>
        </form>
      </div>
    </div>
    <div id="red-line" data-toggler="show-for-medium" class="red-line show-for-medium">
      <div class="row column">
        <div id="main-menu" class="text-center">
          <div class="hide-for-medium"><br>
            <ul class="menu expanded red-line_menu-cart-account">
			  {{ status_bar }}
            </ul><br>
          </div>
		  {% widget 'MenuUser' with { css_class:'menu-base', alias:'main' } %}
          <div class="hide-for-medium">
		    {% widget 'MenuUser' with { css_class:'menu-base', alias:'top' } %}
          </div>
        </div>
      </div>
    </div>

	{% block main %}{% endblock %} 
	
    <div class="footer">
      <div class="row">
        <div class="small-24 medium-8 column">
          <p class="text-gray">&copy; {{ server.name }}</p>
          <p class="text-gray">
			{{ config.address|raw }}
			<br><a class="text-gray" href="tel:{{ config.phone|phone }}">{{ config.phone }}</a>
			<br><a class="text-gray" href="mailto:{{ config.email }}">{{ config.email }}</a>
		  </p>
          <p class="text-gray">
			<a href="#" title="" class="fa-stack fa-lg vk"><i class="fa fa-circle fa-stack-2x"></i><i class="fa fa-vk fa-stack-1x fa-inverse"></i></a>
			<a href="#" title="" class="fa-stack fa-lg tw"><i class="fa fa-circle fa-stack-2x"></i><i class="fa fa-twitter fa-stack-1x fa-inverse"></i></a>
			<a href="#" title="" class="fa-stack fa-lg fb"><i class="fa fa-circle fa-stack-2x"></i><i class="fa fa-facebook fa-stack-1x fa-inverse"></i></a>
			<a href="#" title="" class="fa-stack fa-lg ins"><i class="fa fa-circle fa-stack-2x"></i><i class="fa fa-instagram fa-stack-1x fa-inverse"></i></a>
          </p>
        </div>
        <div class="small-24 medium-8 column">
		  {% widget 'MenuUser' with { css_class:'vertical menu menu-base', alias:'bottom' } %}
          <br>
        </div>
        <div class="small-24 medium-8 column">
          <p class="text-gray">{{ _('Принимаем к оплате') }}</p>
          <p>
			<img src="{{ basePath }}/images/visa.gif" style="width: 48px; height: 24px" alt="visa">
			<img src="{{ basePath }}/images/mc.gif" style="width: 42px; height: 24px" alt="mc">
			<img src="{{ basePath }}/images/sber.gif" style="width: 30px; height: 24px" alt="sber">
			<img src="{{ basePath }}/images/qiwi.gif" style="height: 24px" alt="qiwi">
			<img src="{{ basePath }}/images/ym.gif" style="width: 32px; height: 24px" alt="ym">
			<img src="{{ basePath }}/images/pp.jpg" style="width: 39px; height: 24px" alt="pp">
          </p>
          <p class="text-dark-gray"><br>{{ _('Создание сайта') }} — <a href="http://www.cetera.ru" title="" class="text-dark-gray">Cetera Labs</a></p>
        </div>
      </div>
    </div>
	{{ application.showScripts() }}
  </body>
</html>