<div class="row large-up-2 medium-up-2 small-up-1">
  {% for cat in catalog.children %}

  <div class="column">
    <div class="product"><a class="product__title" href="{{ cat.url }}"><b>{{cat.name}}</b></a>
      <div class="product__img"><a href="{{cat.url}}"><img src="{{cat.pic}}" alt=""></a></div>
    </div>
  </div>

  {% endfor %}
</div>
