{% extends layout %}

{% block main %}  

    <div class="row column">
       {% widget 'Breadcrumbs' with {} %}
    </div>
	
	{% set menu %}{#% if catalog.path|length > 2 %}{% widget 'Menu' with { template: 'menu.twig', catalog: catalog.path[2], css_class: 'side', materials_show: 0, depth: 0, expand_active: true } %}{% endif %#}{% endset %}


    <div class="row">
			{% if menu %}
        <div class="right columns small-24 medium-9 large-6">
		  
		  <div class="content offset">
			  <div class="callout">{{ menu }}
			  </div>
		  </div>
		  
        </div>
        
		{% endif %}
        <div class="center {% if menu %}columns small-24 medium-15 large-18{% else %}column{% endif %}">
		
			{% widget 'Section' with { page404_template: 'page_404.twig', list_template: 'tiles.twig', list_limit: 9, material_share_buttons: 1, list_where: list_where } %}		
		
        </div>

		

    </div>
             
{% endblock %} 