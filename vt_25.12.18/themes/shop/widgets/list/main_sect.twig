<div class="row large-up-3 medium-up-2 small-up-1 text-left medium-text-left">
{% for m in widget.children %}
        <div class="column">
          <div class="product"><a class="product__title" href="{{ m.url}}"><b>{{ m.name}}</b></a>
            <div class="product__img"><a href="{{ m.url}}"><img src="{{ m.pic}}" alt="{{ m.name}}"></a></div>
          </div>
        </div>
{% endfor %}
</div>