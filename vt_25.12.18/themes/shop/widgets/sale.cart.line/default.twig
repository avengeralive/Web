{% if not widget.getParam('ajaxCall') %}
	<span id="{{ widget.uniqueId }}">
{% endif %}

	{% block html %}
	<a href="{{ widget.param('cart_url') }}" title="{{ _('Корзина') }}" class="bar__link">
		<img src="{{ basePath }}images/basket.svg" alt="">

			{% if (widget.cart.getProductsCount() == 0) %}
				<div class="x-cart-count"></div>
			{% else %}
				<div class="bar__num x-cart-count">{{ widget.cart.getProductsCount() }}</div>
			{% endif %}
			
	</a>		 
	{% endblock %}

{% if not widget.getParam('ajaxCall') %}
	</span> 
{% endif %}

{% if not widget.getParam('ajaxCall') %}
	{% set script %}
		{% block script %}
		document.addEventListener('DOMContentLoaded', function () {
		
		jQuery(document).on("cetera.sale.basket.add", function(e,data){	
		
			if (!isNaN(parseInt(data.count)))
			{
				if ((parseInt(data.count) == 0))
				{
					jQuery("#{{ widget.uniqueId }} .x-cart-count").removeClass("bar__num");
					jQuery("#{{ widget.uniqueId }} .x-cart-count").empty();

				}
				else
				{
					jQuery("#{{ widget.uniqueId }} .x-cart-count").addClass("bar__num");
				
					jQuery("#{{ widget.uniqueId }} .x-cart-count").html(data.count);
					jQuery("#{{ widget.uniqueId }} .x-cart-total").html(data.total);
					jQuery("#{{ widget.uniqueId }} .x-cart-total-display").html(data.total_display);
				}
					

				
			}
			
		});
		
		});
		{% endblock %}
	{% endset %}
	{% do widget.application.addHeadString( "<script>#{script}</script>" ) %}
{% endif %}
