				c[i].addEventListener("change", function(e){
					var id = this.getAttribute('data-id');
					var itemId = '#x-cart-item-' + id + ' ';
					var v = parseInt(document.querySelector(itemId + ".x-quantity").value);
					if (isNaN(v)) v = 0;
					if (v<1) v = 1;
					{{ widget.uniqueId }}_change(itemId,v,id);
				});


		});

		function {{ widget.uniqueId }}_change(itemId,v,id)
		{
			document.querySelector(itemId + ".x-quantity").value = v;
			var s = document.querySelector(itemId + ".x-sum");
			var sum = document.querySelector("#{{ widget.uniqueId }} .x-total-sum");
			sum.innerHTML = '{{ _('Подождите...') }}';
			s.innerHTML = '{{ _('Подождите...') }}';

			jQuery.ajax({
				url : '/plugins/sale/ajax.php?action=set_cart_quantity&id='+id+'&quantity='+v,
				dataType: 'json',
				success: function(data) {
					jQuery(document).trigger( 'cetera.sale.basket.add', [ data ] );
					sum.innerHTML = data.total_sum;
					s.innerHTML = data.sum;
					document.querySelector("#{{ widget.uniqueId }} .x-total-quantity").innerHTML = data.count + ' {{ _('шт.') }}';
					if (v == 0)
					{
						var row = document.querySelector(itemId);
						if (row) row.parentNode.removeChild(row);
					}
					checkCart(data.count);
				}
			});
		}

		function checkCart(total)
		{
			if (total == 0)
			{
			$('.discount__bar').remove();
			$('.discount__bar__empty').removeClass('hide');
			}

		}


{% endset %}
{% do widget.application.addHeadString( "<script>#{script}</script>" ) %}

{% endif %}
