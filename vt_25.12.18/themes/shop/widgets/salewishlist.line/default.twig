
{% if not widget.getParam('ajaxCall') %}
	<span id="{{ widget.uniqueId }}">
{% endif %}

	{% block html %}
	<a class="bar__link" href="/personal/wishlist"><img src="{{ basePath }}images/heart.svg" alt="">

	{% if (widget.getCount() == 0) %}
		<div class="x-wishlist-count"></div>
	{% else %}
		<div class="bar__num x-wishlist-count">{{ widget.getCount() }}</div>
	{% endif %}
			
	</a>	 
	{% endblock %}

{% if not widget.getParam('ajaxCall') %}
	</span> 
{% endif %}

{% if not widget.getParam('ajaxCall') %}
	{% set script %}
		{% block script %}
		document.addEventListener('DOMContentLoaded', function () {
		jQuery(document).on("cetera.sale.wishlist.add", function(e,data){	
		
			if (!isNaN(parseInt(data.count)))
			{
				if ((parseInt(data.count) == 0))
				{
					jQuery("#{{ widget.uniqueId }} .x-wishlist-count").removeClass("bar__num");
					jQuery("#{{ widget.uniqueId }} .x-wishlist-count").empty();

				}
				else
				{
					jQuery("#{{ widget.uniqueId }} .x-wishlist-count").addClass("bar__num");
		
					jQuery("#{{ widget.uniqueId }} .x-wishlist-count").html(data.count);

				}
					
			}
			
		});
		
		});
		{% endblock %}
	{% endset %}
	{% do widget.application.addHeadString( "<script>#{script}</script>" ) %}
{% endif %}
