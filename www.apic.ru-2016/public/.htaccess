##	RewriteRule ^ticket/(.*)/$ /2013/ticket.php?hash=$1 [L]
##	RewriteRule ^ticket-topclimat/(.*)/$ /2013/ticket-topclimat.php?hash=$1 [L]

##	RewriteRule ^eng/ticket/(.*)/$ /2013/ticket.php?hash=$1 [L]



RewriteRule ^robots.txt$ /cms.php?ID=/robotstxt/ [L]
RewriteRule ^$ /cms.php?ID=/ [L]


##	RewriteRule ^eng/brand/$ /cms.php?ID=/brand/&subID=eng [L]
##	RewriteRule ^eng/brand/(.*)/$ /cms.php?ID=/brand/$1/&subID=eng [L]


RewriteCond %{QUERY_STRING} subID=([a-zA-Z0-9]*)
RewriteRule ^account\/(.*)\/.*$      /cms.php?ID=/account/&action=$1&subID=%1 [L]


RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^account\/(.*)\/.*$      /cms.php?ID=/account/&action=$1&subID= [L]



RewriteCond %{QUERY_STRING} action=([-_a-zA-Z0-9]*)([^s]*)subID=([a-zA-Z0-9]*)([^q]*)offset=([a-zA-Z0-9]*)
RewriteRule ^(.*)\/$       /cms.php?ID=/$1/&action=%1&subID=%3&offset=%5 [L]



RewriteCond %{QUERY_STRING} action=([-_a-zA-Z0-9]*)([^s]*)subID=([a-zA-Z0-9]*)([^q]*)q=([a-zA-Z0-9]*)
RewriteRule ^(.*)\/$       /cms.php?ID=/$1/&action=%1&subID=%3&q=%5 [L]


RewriteCond %{QUERY_STRING} action=([-_a-zA-Z0-9]*)([^s]*)subID=([a-zA-Z0-9]*)
RewriteRule ^(.*)\/$       /cms.php?ID=/$1/&action=%1&subID=%3 [L]




RewriteCond %{QUERY_STRING} action=([-_a-zA-Z0-9]*)([^s]*)subID=([a-zA-Z0-9]*)
RewriteRule ^(.*)\/.*$       /cms.php?ID=/$1/&action=%1&subID=%3 [L]


RewriteCond %{QUERY_STRING} action=([-_a-zA-Z0-9]*)
RewriteRule ^(.*)\/$       /cms.php?ID=/$1/&action=%1 [L]


RewriteCond %{QUERY_STRING} q=([^&]*)([^p]*)page=([0-9]*)
RewriteRule ^(.*)\/$       /cms.php?ID=/$1/&q=%1&page=%3 [L]


RewriteCond %{QUERY_STRING} q=([^&]*)([^s]*)showall
RewriteRule ^(.*)\/$       /cms.php?ID=/$1/&q=%1&showall=1 [L]


RewriteCond %{QUERY_STRING} q=([^&]*)
RewriteRule ^(.*)\/$       /cms.php?ID=/$1/&q=%1 [L]


RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)\/$       /cms.php?ID=/$1/ [L]


