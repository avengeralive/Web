errordocument 404 /cms.php
errordocument 403 /cms.php

#errordocument 404 /404.html
#errordocument 404 /cms.php

#=============================

Options +Includes
Options -Indexes
XBitHack on
XBitHack Full
php_value display_errors 2047
php_value display_startup_errors 1
php_value error_reporting  2047
php_value default_charset windows-1251


php_flag register_globals 1


php_value display_errors 0


php_value session.gc_maxlifetime 3600  
php_value session.cookie_lifetime 3600


php_value magic_quotes_gpc 0
php_value magic_quotes_runtime 0
php_value magic_quotes_sybase 0
## zlib compression ON for php 
php_value zlib.output_compression 0
php_value zlib.output_compression_level 0
DirectoryIndex index.html  index.plx index.jsp index.htm index.php

RewriteEngine on
RewriteRule (jpg|gif|png|js|favicon|css)$     - [L]

#	RewriteRule ^main/about/special/geogr_2013/    /cms.php?ID=/topics/ventilation/grilles/cfera_2013/  [L]
#	RewriteRule ^main/about/special/celi_2013/       /cms.php?ID=/topics/ventilation/grilles/celi_2013/ [L]
#	RewriteRule ^main/about/special/vystavka_2013/    /cms.php?ID=/topics/ventilation/grilles/vystavka_2013/ [L]
#	RewriteRule ^main/about/special/dolgnot_2013/    /cms.php?ID=/topics/ventilation/grilles/dolgnot_2013/ [L]
#	RewriteRule ^main/about/special/cfera_2013/    /cms.php?ID=/topics/ventilation/grilles/cfera_2013/ [L]



RewriteEngine On
RewriteBase /
RewriteRule ^about$ /cms.php?ID=/about/ [L]
RewriteRule ^about/$ /cms.php?ID=/about/ [L]



RewriteEngine On
RewriteBase /
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^(.+) - [PT,L]

RewriteCond %{QUERY_STRING} firm=([0-9]+) 
RewriteRule ^members/member\.php$ members/action-%1/? [R=301,L]
RewriteCond %{QUERY_STRING} firm=([0-9]+)
RewriteRule ^members/member1\.php$ members/action-%1/? [R=301,L]
RewriteCond %{QUERY_STRING} firm=([0-9]+)
RewriteRule ^members/member2\.php$ members/action-%1/? [R=301,L]
RewriteCond %{QUERY_STRING} firm=([0-9]+)
RewriteRule ^members/en/member\.php$ en/members_apic/action-%1/? [R=301,L]
RewriteCond %{QUERY_STRING} firm=([0-9]+)
RewriteRule ^members/en/member1\.php$ en/members_apic/action-%1/? [R=301,L]
RewriteCond %{QUERY_STRING} id_o=([0-9]+)&id_so=([0-9]+)&id_f=([0-9]+)
RewriteRule ^object/object\.php$ members/action-%1/? [R=301,L]
RewriteCond %{QUERY_STRING} id_so=([0-9]+)
RewriteRule ^object/$ members/action-%1/? [R=301,L]


RewriteRule ^robots.txt$ /cms.php?ID=/robotstxt/ [L]




