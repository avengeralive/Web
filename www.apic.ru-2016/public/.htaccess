##	RewriteRule ^main/match$ /index_old.php?part_sid=main&sect_sid=match&g_mode=login [L]
##	RewriteRule ^main/match/(.*)/$ /index_old.php?part_sid=main&sect_sid=match&g_mode=$1 [L]



